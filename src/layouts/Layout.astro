---
import '../styles/globals.css';
import 'lenis/dist/lenis.css';
import BlockRevealTransition from '../components/BlockRevealTransition.astro';
import PixelCursorTrail from '../components/ui/pixel-trail';
---

<!doctype html>
<html lang="en" data-lang="en" style="background-color: #EE5037;">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=7" />
		<link rel="icon" href="/favicon.ico?v=7" sizes="16x16 32x32" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Pedro Lourenço — Web designer creating clear interfaces, refined websites, and digital experiences." />
		<title>Pedro Lourenço | Webdesigner</title>

		<script is:inline>
			(function() {
				try {
					// Garante que o site inicie em EN por padrão
					if (!localStorage.getItem('portfolio_default_en_set')) {
						localStorage.setItem('portfolio_default_en_set', 'true');
						localStorage.setItem('portfolio_lang', 'EN');
					}
					var saved = (localStorage.getItem('portfolio_lang') || 'EN').toUpperCase();
					var isPt = saved === 'PT';
					document.documentElement.setAttribute('data-lang', isPt ? 'pt' : 'en');
					document.documentElement.lang = isPt ? 'pt-BR' : 'en';
				} catch (e) {}
			})();
		</script>

		<!-- Critical Font Preload (self-hosted WOFF2) & Hero LCP Image Preload -->
		<link rel="preload" as="font" type="font/woff2" href="/fonts/rethink-sans-latin.woff2" crossorigin />
		<link
			rel="preload"
			as="image"
			href="/images/optimized/hero-portrait-1920.avif"
			type="image/avif"
			imagesrcset="/images/optimized/hero-portrait-768.avif 768w, /images/optimized/hero-portrait-1280.avif 1280w, /images/optimized/hero-portrait-1920.avif 1920w"
			imagesizes="100vw"
			fetchpriority="high"
		/>
	</head>
	<body style="background-color: #EE5037;">
		<PixelCursorTrail client:media="(hover: hover) and (pointer: fine)" />
		<BlockRevealTransition />
		<slot />

		<script>
			import Lenis from 'lenis';
			import gsap from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			let tickerHandler: ((time: number) => void) | null = null;

			function initLenis() {
				if ((window as any).lenis) {
					(window as any).lenis.destroy();
				}
				if (tickerHandler) {
					gsap.ticker.remove(tickerHandler);
				}

				// No mobile/touch: desativa smooth scroll interceptado do Lenis para usar o scroll nativo a 120Hz/60Hz com inércia física do sistema operacional
				const isTouchDevice =
					typeof window !== 'undefined' &&
					(window.matchMedia('(max-width: 900px)').matches ||
						window.matchMedia('(hover: none) and (pointer: coarse)').matches ||
						'ontouchstart' in window ||
						navigator.maxTouchPoints > 0);

				if (isTouchDevice) {
					if ((window as any).lenis) {
						(window as any).lenis.destroy();
					}
					(window as any).lenis = null;
					document.documentElement.classList.remove('lenis', 'lenis-smooth', 'lenis-stopped');
					document.documentElement.style.scrollBehavior = '';

					// Impede que a alteração da barra de endereços do mobile dispare recálculos bruscos de layout
					ScrollTrigger.config({ ignoreMobileResize: true });
					setTimeout(() => ScrollTrigger.refresh(), 100);

					document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
						anchor.addEventListener('click', (e) => {
							const href = anchor.getAttribute('href');
							if (href && href.length > 1) {
								if (href === '#about') {
									const pinTrig = ScrollTrigger.getById('globe-zoom-pin-trigger');
									if (pinTrig) {
										e.preventDefault();
										const targetScroll = pinTrig.start + (pinTrig.end - pinTrig.start) * 0.95;
										window.scrollTo({ top: targetScroll, behavior: 'smooth' });
										return;
									}
								}
								if (href === '#contact') {
									e.preventDefault();
									window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
									return;
								}
								const target = document.querySelector(href);
								if (target) {
									e.preventDefault();
									target.scrollIntoView({ behavior: 'smooth' });
								}
							}
						});
					});
					return;
				}

				const lenis = new Lenis({
					autoRaf: false,
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					orientation: 'vertical',
					gestureOrientation: 'vertical',
					smoothWheel: true,
					wheelMultiplier: 1.1,
					touchMultiplier: 1.0,
					infinite: false,
				});

				(window as any).lenis = lenis;

				// Synchronize Lenis with ScrollTrigger in the exact same render frame
				lenis.on('scroll', ScrollTrigger.update);

				tickerHandler = (time: number) => {
					lenis.raf(time * 1000);
				};
				gsap.ticker.add(tickerHandler);
				// Disable GSAP lag smoothing to prevent desync and stuttering with Lenis
				gsap.ticker.lagSmoothing(0);

				// Smooth scroll to in-page anchor targets
				document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
					anchor.addEventListener('click', (e) => {
						const href = anchor.getAttribute('href');
						if (href && href.length > 1) {
							if (href === '#about') {
								const pinTrig = ScrollTrigger.getById('globe-zoom-pin-trigger');
								if (pinTrig) {
									e.preventDefault();
									const targetScroll = pinTrig.start + (pinTrig.end - pinTrig.start) * 0.95;
									lenis.scrollTo(targetScroll, { duration: 1.2 });
									return;
								}
							}
							if (href === '#contact') {
								e.preventDefault();
								lenis.scrollTo(document.documentElement.scrollHeight, { duration: 1.4 });
								return;
							}
							const target = document.querySelector(href);
							if (target) {
								e.preventDefault();
								lenis.scrollTo(target as HTMLElement, { offset: 0, duration: 1.2 });
							}
						}
					});
				});
			}

			initLenis();
			document.addEventListener('astro:after-swap', initLenis);
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Rethink Sans';
		font-style: normal;
		font-weight: 400 800;
		font-display: swap;
		src: url('/fonts/rethink-sans-latin.woff2') format('woff2');
	}

	@font-face {
		font-family: 'JetBrains Mono';
		font-style: normal;
		font-weight: 400 800;
		font-display: swap;
		src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Silkscreen';
		font-style: normal;
		font-weight: 400;
		font-display: swap;
		src: url('/fonts/silkscreen-400-latin.woff2') format('woff2');
	}

	@font-face {
		font-family: 'Silkscreen';
		font-style: normal;
		font-weight: 700;
		font-display: swap;
		src: url('/fonts/silkscreen-700-latin.woff2') format('woff2');
	}

	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	/* Hide default scrollbar completely across Chrome, Safari, Edge, Firefox */
	::-webkit-scrollbar {
		display: none !important;
		width: 0 !important;
		height: 0 !important;
	}

	html {
		width: 100%;
		height: auto;
		background-color: #EE5037;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	body {
		width: 100%;
		min-height: 100%;
		background-color: #EE5037;
		color: #ffffff;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		overflow-x: clip;
		overflow-y: visible;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button, input, select, textarea {
		font-family: inherit;
		cursor: pointer;
	}
</style>

