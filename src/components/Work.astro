---
// Work.astro — Seção de Trabalhos com layout quebrado (assimétrico 7x5 e 5x7),
// projetos dinâmicos (originais + Sanity), fundo claro (#E8E6E0) e largura alinhada com a Hero.
import { SlideUpText } from './ui/slide-up-text';
import { type Project, defaultProjects } from '../data/projects';

interface Props {
	sectionTitle?: string;
	buttonText?: string;
	buttonHref?: string;
	projects?: Project[];
}

const {
	sectionTitle = "Selected Work",
	buttonText = "VIEW ALL PROJECTS",
	buttonHref = "#work",
	projects = defaultProjects
} = Astro.props;
---

<section class="work-section" id="work" aria-label="Selected Work">
	<div class="work-container">
		<!-- Linha de Cabeçalho: "Selected Work" à esquerda + "VIEW ALL PROJECTS" à direita -->
		<header class="work-header-row">
			<h2 class="work-title lang-pt">
				<SlideUpText
					client:visible
					inView
					split="characters"
					stagger={0.03}
				>
					Meus Trabalhos
				</SlideUpText>
			</h2>
			<h2 class="work-title lang-en">
				<SlideUpText
					client:visible
					inView
					split="characters"
					stagger={0.03}
				>
					Selected Work
				</SlideUpText>
			</h2>
			<a href={buttonHref} class="work-header-link lang-pt" aria-label="Ver todos os projetos">
				<SlideUpText
					client:visible
					inView
					split="words"
					stagger={0.04}
					delay={0.15}
					className="link-text"
				>
					VER TODOS OS PROJETOS
				</SlideUpText>
			</a>
			<a href={buttonHref} class="work-header-link lang-en" aria-label="View all projects">
				<SlideUpText
					client:visible
					inView
					split="words"
					stagger={0.04}
					delay={0.15}
					className="link-text"
				>
					VIEW ALL PROJECTS
				</SlideUpText>
			</a>
		</header>

		<!-- Grid Assimétrico Quebrado Fiel à Referência (Linha 1: 7x5 | Linha 2: 5x7) -->
		<div class="works-grid">
			{projects.map((project) => {
				const mediaStyle = [
					project.objectFit ? `object-fit: ${project.objectFit};` : '',
					project.objectPosition ? `object-position: ${project.objectPosition};` : ''
				].filter(Boolean).join(' ') || undefined;
				const cardStyle = project.bgColor ? `background-color: ${project.bgColor};` : undefined;
				const isExternal = /^https?:\/\//i.test(project.href);

				return (
					<article class={`work-card ${project.gridClass}`} data-pixel-color={project.pixelColor || "#EE5037"}>
						<a
							href={project.href}
							target={isExternal ? "_blank" : undefined}
							rel={isExternal ? "noopener noreferrer" : undefined}
							class="work-card-link"
							aria-label={`View project ${project.title}`}
						>
							<div class="work-card-media">
								{project.video ? (
									<video
										src={project.video}
										poster={project.videoPoster}
										preload="none"
										data-lazy-video
										loop
										muted
										playsinline
										width="1280"
										height="720"
										class="work-card-img work-card-video work-card-bg-media"
										style={mediaStyle}
									/>
								) : project.imageOpt ? (
									<picture style="display: contents;">
										<source
											type="image/avif"
											srcset={`${project.imageOpt.base}-${project.imageOpt.widths[0]}.avif ${project.imageOpt.widths[0]}w, ${project.imageOpt.base}-${project.imageOpt.widths[1]}.avif ${project.imageOpt.widths[1]}w`}
											sizes={project.imageOpt.sizes}
										/>
										<source
											type="image/webp"
											srcset={`${project.imageOpt.base}-${project.imageOpt.widths[0]}.webp ${project.imageOpt.widths[0]}w, ${project.imageOpt.base}-${project.imageOpt.widths[1]}.webp ${project.imageOpt.widths[1]}w`}
											sizes={project.imageOpt.sizes}
										/>
										<img
											src={project.image}
											alt={project.title}
											class="work-card-img work-card-bg-media"
											style={mediaStyle}
											width={project.imageOpt.width}
											height={project.imageOpt.height}
											loading="lazy"
											decoding="async"
										/>
									</picture>
								) : (
									<img
										src={project.image}
										alt={project.title}
										class="work-card-img work-card-bg-media"
										style={mediaStyle}
										loading="lazy"
										decoding="async"
									/>
								)}

								<!-- Canvas interativo de preenchimento por pixel (efeito referência haoqi.design) -->
								<canvas class="work-card-pixel-canvas" aria-hidden="true"></canvas>

								<!-- Conteúdo do Hover sobre os Pixels da Cor do Projeto -->
								<div
									class="work-card-pixel-overlay"
									aria-hidden="true"
									style={project.pixelTextColor ? `--pixel-text-color: ${project.pixelTextColor};` : undefined}
								>
									<div class="pixel-overlay-top">
										<span class="pixel-tag lang-pt">{project.tag?.pt || "[PROJETO SELECIONADO]"}</span>
										<span class="pixel-tag lang-en">{project.tag?.en || "[SELECTED PROJECT]"}</span>
										<span class="pixel-year">{project.year || "2026"}</span>
									</div>

									<div class="pixel-overlay-center">
										<h3 class="pixel-project-title">{project.title}</h3>
										<p class="pixel-project-desc lang-pt">{project.description?.pt || ''}</p>
										<p class="pixel-project-desc lang-en">{project.description?.en || ''}</p>
									</div>
								</div>

								<!-- Nome do projeto no canto inferior esquerdo -->
								<div class="work-card-caption">
									<h3 class="card-caption-title">{project.title}</h3>
								</div>
							</div>
						</a>
					</article>
				);
			})}
		</div>
	</div>
</section>

<style>
	/* --------------------------------------------------
	 * Estrutura da Seção: Fundo Claro Original (#E8E6E0)
	 * -------------------------------------------------- */
	.work-section {
		position: relative;
		width: 100%;
		background-color: transparent;
		color: #111215;
		padding: clamp(4.5rem, 8.5vh, 7.5rem) 0 clamp(3.5rem, 6vh, 5rem) 0;
		margin: 0;
		box-sizing: border-box;
		overflow: hidden;
		z-index: 10;
	}

	/* Largura da Hero: max-width 1920px e padding lateral idêntico à Hero */
	.work-container {
		position: relative;
		width: 100%;
		max-width: 1920px;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 4.5rem);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}

	/* --------------------------------------------------
	 * Top Bar: Título "Meus Trabalhos" + "VIEW ALL PROJECTS"
	 * -------------------------------------------------- */
	.work-header-row {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		width: 100%;
		gap: 1.5rem;
		margin-bottom: clamp(2rem, 3.5vh, 3rem);
	}

	.work-title {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(2.8rem, 4.5vw, 4.8rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		color: #111215;
		margin: 0;
		line-height: 1.05;
	}

	.work-header-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem 0.65rem;
		margin: -0.35rem 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.72rem, 0.85vw, 0.86rem);
		font-weight: 700;
		color: #111215;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		transition: opacity 0.2s ease;
		white-space: nowrap;
	}

	.work-header-link::before {
		content: '';
		position: absolute;
		inset: 0;
		border: 1.5px dotted transparent;
		pointer-events: none;
		transition: border-color 0.2s ease;
	}

	.work-header-link:hover {
		opacity: 0.85;
	}

	.work-header-link:hover::before {
		border-color: currentColor;
	}

	/* --------------------------------------------------
	 * Grid Assimétrico Quebrado Fiel à Referência
	 * Linha 1: [ 7 cols ] [ 5 cols ]
	 * Linha 2: [ 5 cols ] [ 7 cols ]
	 * -------------------------------------------------- */
	.works-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: clamp(14px, 1.8vw, 24px);
		width: 100%;
	}

	.work-card {
		position: relative;
		width: 100%;
		height: clamp(500px, 64vh, 760px);
		border-radius: 0;
		border: none !important;
		outline: none !important;
		background-color: transparent !important;
		box-shadow: none !important;
		display: block;
		text-decoration: none;
		color: #111215;
		isolation: isolate;
	}

	/* Linha 1 */
	.card-row1-left {
		grid-column: span 7;
	}

	.card-row1-right {
		grid-column: span 5;
	}

	/* Linha 2 */
	.card-row2-left {
		grid-column: span 5;
	}

	.card-row2-right {
		grid-column: span 7;
	}

	.work-card-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
		border: none !important;
		outline: none !important;
		color: inherit;
		cursor: pointer;
	}

	.work-card-media {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		background-color: transparent !important;
		border: none !important;
		outline: none !important;
		box-shadow: none !important;
		border-radius: 0;
		isolation: isolate;
	}

	.work-card-img,
	.work-card-video {
		width: calc(100% + 2px);
		height: calc(100% + 2px);
		margin: -1px;
		object-fit: cover;
		object-position: center;
		display: block;
		border-radius: 0;
		border: none !important;
		outline: none !important;
		box-shadow: none !important;
		user-select: none;
		pointer-events: none;
		filter: none;
		transform: none;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	.work-card-video {
		background-color: transparent !important;
	}

	/* --------------------------------------------------
	 * Canvas de Pixels e Overlay no Hover (Efeito haoqi.design)
	 * -------------------------------------------------- */
	.work-card-pixel-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 2;
		border-radius: inherit;
	}

	.work-card-pixel-overlay {
		position: absolute;
		inset: 0;
		z-index: 3;
		padding: clamp(1.4rem, 2.4vw, 2.4rem);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		pointer-events: none;
		color: #FFFFFF;
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: opacity, transform;
	}

	.work-card.is-pixel-active .work-card-pixel-overlay {
		opacity: 1;
		transform: translateY(0);
		transition-delay: 0.35s;
	}

	.pixel-overlay-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		font-family: 'JetBrains Mono', 'Space Mono', ui-monospace, monospace;
		font-size: clamp(0.72rem, 0.82vw, 0.84rem);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--pixel-text-color, #FFFFFF);
	}

	.pixel-tag {
		background: transparent;
		color: var(--pixel-text-color, #FFFFFF);
		padding: 0;
		border: none;
		backdrop-filter: none;
		opacity: 0.95;
	}

	.pixel-year {
		font-variant-numeric: tabular-nums;
		color: var(--pixel-text-color, rgba(255, 255, 255, 0.88));
	}

	.pixel-overlay-center {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 1rem 0;
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
	}

	.pixel-project-title {
		font-family: 'JetBrains Mono', 'Space Mono', ui-monospace, monospace;
		font-size: clamp(1.5rem, 3vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--pixel-text-color, #FFFFFF) !important;
		margin: 0 0 0.75rem 0;
		line-height: 1.05;
		text-shadow: none !important;
	}

	.pixel-project-desc {
		font-family: 'JetBrains Mono', 'Space Mono', ui-monospace, monospace;
		font-size: clamp(0.82rem, 0.95vw, 1.05rem);
		font-weight: 600;
		color: var(--pixel-text-color, rgba(255, 255, 255, 0.94)) !important;
		line-height: 1.45;
		margin: 0;
		max-width: 480px;
		text-shadow: none !important;
	}

	.pixel-overlay-bottom {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		width: 100%;
		font-family: 'JetBrains Mono', 'Space Mono', ui-monospace, monospace;
		font-size: clamp(0.72rem, 0.82vw, 0.84rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #FFFFFF;
	}

	.pixel-brand {
		display: none;
	}

	.pixel-action {
		background: #FFFFFF;
		color: #111215 !important;
		padding: 0.45rem 0.95rem;
		border-radius: 0;
		font-weight: 700;
		letter-spacing: 0.05em;
		box-shadow: none !important;
		transition: transform 0.2s ease;
	}

	/* --------------------------------------------------
	 * Legenda no Canto Inferior Esquerdo (Apenas Nome)
	 * -------------------------------------------------- */
	.work-card-caption {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: clamp(1rem, 2vw, 1.8rem);
		background: none;
		display: flex;
		flex-direction: column;
		pointer-events: none;
		z-index: 1;
		opacity: 1;
		transform: translateY(0);
		transition: opacity 0.35s ease, transform 0.35s ease;
		will-change: opacity, transform;
	}

	.work-card.is-pixel-active .work-card-caption {
		opacity: 0;
		transform: translateY(6px);
	}

	.card-caption-title {
		margin: 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(1.25rem, 1.55vw, 1.6rem);
		font-weight: 700;
		color: #FFFFFF !important;
		text-transform: none !important;
		letter-spacing: -0.015em;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.55), 0 2px 12px rgba(0, 0, 0, 0.35);
	}


	/* --------------------------------------------------
	 * Responsividade Tablet & Mobile
	 * -------------------------------------------------- */
	@media (max-width: 900px) {
		.work-section {
			padding: 3.5rem 0 1.5rem 0;
		}

		.work-container {
			padding: 0 1rem;
		}

		.work-header-row {
			flex-wrap: wrap;
			gap: 0.85rem;
		}

		.work-title {
			font-size: clamp(2.2rem, 7vw, 3.2rem);
		}

		.works-grid {
			grid-template-columns: 1fr;
			gap: clamp(16px, 3.5vw, 24px);
		}

		.card-row1-left,
		.card-row1-right,
		.card-row2-left,
		.card-row2-right {
			grid-column: span 1;
		}

		/* Proporção 16:9 widescreen para mobile: preserva os layouts desktop sem cortar títulos ou esticar */
		.work-card {
			width: 100%;
			height: auto !important;
			min-height: unset !important;
			max-height: unset !important;
		}

		.work-card-media {
			width: 100%;
			height: auto !important;
			aspect-ratio: 16 / 9;
		}

		.work-card,
		.work-card-media,
		.work-card-img,
		.work-card-video {
			border-radius: 0;
		}

		.work-card-caption {
			padding: clamp(0.5rem, 2vw, 0.9rem) clamp(0.75rem, 2.5vw, 1.25rem);
			background: none;
		}

		.card-caption-title {
			font-size: clamp(1.05rem, 3.5vw, 1.35rem);
		}

		.work-card-img,
		.work-card-video {
			width: calc(100% + 2px);
			height: calc(100% + 2px);
			margin: -1px;
			object-fit: cover !important;
			object-position: center !important;
		}
	}

	/* Desativa todos os efeitos de hover no mobile e dispositivos touch: cards e links */
	@media (max-width: 900px), (hover: none), (pointer: coarse) {
		.work-card,
		.work-card-link {
			-webkit-tap-highlight-color: transparent;
		}

		.work-card:hover .work-card-img,
		.work-card:hover .work-card-video,
		.work-card:focus-within .work-card-img,
		.work-card:focus-within .work-card-video,
		.work-card:active .work-card-img,
		.work-card:active .work-card-video {
			transform: none !important;
		}

		.work-card-pixel-canvas {
			display: none !important;
		}

		.work-card-pixel-overlay {
			display: none !important;
		}

		.work-header-link:hover,
		.work-header-link:active {
			opacity: 1 !important;
		}

		.work-header-link::before,
		.work-header-link:hover::before,
		.work-header-link:active::before {
			display: none !important;
			border-color: transparent !important;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function initWorkEntrance() {
		const header = document.querySelector('.work-header-row') as HTMLElement | null;
		const allCards = Array.from(document.querySelectorAll<HTMLElement>('.work-card'));
		if (!header || !allCards.length) return;

		// Acessibilidade: respeita quem prefere movimento reduzido
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set(allCards, {
				opacity: 1,
				y: 0,
				scale: 1,
			});
			return;
		}

		const isMobile = window.innerWidth <= 900;

		if (isMobile) {
			// No mobile: cada card sobe suavemente conforme o usuário rola até ele
			allCards.forEach((card) => {
				gsap.fromTo(
					card,
					{
						opacity: 0,
						y: 45,
						scale: 0.98,
					},
					{
						opacity: 1,
						y: 0,
						scale: 1,
						duration: 0.85,
						ease: 'power3.out',
						clearProps: 'transform',
						scrollTrigger: {
							trigger: card,
							start: 'top 88%',
							toggleActions: 'play none none none',
							once: true,
						},
					}
				);
			});
		} else {
			// No desktop: agrupados em pares com stagger refinado
			for (let i = 0; i < allCards.length; i += 2) {
				const rowCards = allCards.slice(i, i + 2);
				if (!rowCards.length) continue;

				gsap.fromTo(
					rowCards,
					{
						opacity: 0,
						y: 55,
						scale: 0.97,
					},
					{
						opacity: 1,
						y: 0,
						scale: 1,
						duration: 0.95,
						stagger: 0.14,
						ease: 'power3.out',
						clearProps: 'transform',
						scrollTrigger: {
							trigger: rowCards[0],
							start: 'top 85%',
							toggleActions: 'play none none none',
							once: true,
						},
					}
				);
			}
		}

		// No desktop: reprodução contínua. No mobile: controlado por demanda via initLazyVideos()
		if (!isMobile) {
			const videos = document.querySelectorAll('.work-card-video, .work-card-mini-video');
			videos.forEach((v) => {
				const video = v as HTMLVideoElement;
				video.muted = true;
				video.play().catch(() => {});
			});
		}

		// Sincroniza o vídeo miniatura com o vídeo de fundo no hover
		document.querySelectorAll('.work-card').forEach((card) => {
			card.addEventListener('mouseenter', () => {
				const bgVid = card.querySelector('.work-card-video') as HTMLVideoElement | null;
				const miniVid = card.querySelector('.work-card-mini-video') as HTMLVideoElement | null;
				if (bgVid && miniVid) {
					miniVid.currentTime = bgVid.currentTime;
					miniVid.play().catch(() => {});
				}
			});
		});

		// Vídeos em viewport via IntersectionObserver (evita baixar MP4 antes da dobra)
		initLazyVideos();

		// Preenchimento interativo com pixels no hover (Efeito haoqi.design)
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => initPixelCards(), { timeout: 1200 });
		} else {
			setTimeout(initPixelCards, 150);
		}

		// Fallback: se a seção já estiver visível no carregamento
		const section = document.querySelector('.work-section') as HTMLElement | null;
		if (section) {
			const rect = section.getBoundingClientRect();
			if (rect.top < window.innerHeight * 0.8 && rect.bottom > 0) {
				gsap.set(allCards.slice(0, 2), { opacity: 1, y: 0, scale: 1 });
			}
		}
	}

	function initLazyVideos() {
		const videos = document.querySelectorAll<HTMLVideoElement>('video[data-lazy-video]');
		if (!videos.length) return;

		if (!('IntersectionObserver' in window)) {
			videos.forEach((v) => v.play().catch(() => {}));
			return;
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const video = entry.target as HTMLVideoElement;
					if (entry.isIntersecting) {
						if (video.preload === 'none') video.preload = 'metadata';
						video.play().catch(() => {});
					} else if (!video.paused) {
						video.pause();
					}
				});
			},
			{ rootMargin: '250px 0px', threshold: 0.05 }
		);

		videos.forEach((video) => observer.observe(video));
	}

	function createPixelDistanceWorker(): Worker | null {
		if (typeof Worker === 'undefined' || typeof Blob === 'undefined') return null;
		try {
			const code = `self.onmessage = function(e) {
				var d = e.data;
				var cols = d.cols, rows = d.rows, dotSize = d.dotSize, mx = d.mouseX, my = d.mouseY;
				var out = new Float32Array(cols * rows);
				for (var r = 0; r < rows; r++) {
					var cy = (r + 0.5) * dotSize;
					var dy = cy - my;
					for (var col = 0; col < cols; col++) {
						var cx = (col + 0.5) * dotSize;
						out[r * cols + col] = Math.hypot(cx - mx, dy);
					}
				}
				self.postMessage({ id: d.id, cols: cols, rows: rows, mx: mx, my: my, dists: out }, [out.buffer]);
			};`;
			const blob = new Blob([code], { type: 'application/javascript' });
			return new Worker(URL.createObjectURL(blob));
		} catch {
			return null;
		}
	}

	function isMobileOrTouch(): boolean {
		return window.innerWidth <= 900 || window.matchMedia('(max-width: 900px), (hover: none), (pointer: coarse)').matches;
	}

	function initPixelCards() {
		if (isMobileOrTouch()) return;

		const cards = document.querySelectorAll('.work-card');
		const DOT_SIZE = 18;
		const BAND = 180;
		const distWorker = createPixelDistanceWorker();
		const pendingCallbacks = new Map<number, (dists: Float32Array, cols: number, rows: number, mx: number, my: number) => void>();
		let jobCounter = 0;

		if (distWorker) {
			distWorker.onmessage = (e: MessageEvent) => {
				const { id, dists, cols, rows, mx, my } = e.data;
				const cb = pendingCallbacks.get(id);
				if (cb) {
					pendingCallbacks.delete(id);
					cb(dists, cols, rows, mx, my);
				}
			};
		}

		cards.forEach((c) => {
			const card = c as HTMLElement;
			const canvas = card.querySelector('.work-card-pixel-canvas') as HTMLCanvasElement | null;
			if (!canvas) return;

			const ctx = canvas.getContext('2d');
			if (!ctx) return;

			// Cor individual dos pixels definida pelo projeto (ex: VerdeVivo usa verde)
			const FILL_COLOR = card.getAttribute('data-pixel-color') || '#EE5037';

			let w = 0;
			let h = 0;
			let cols = 0;
			let rows = 0;
			let mouseX = 0;
			let mouseY = 0;
			let cachedDists: Float32Array | null = null;
			let cachedMx = -1;
			let cachedMy = -1;
			let progress = 0;
			let targetProgress = 0;
			let animId: number | null = null;

			function requestDistanceMap(mx: number, my: number) {
				if (!distWorker || cols === 0 || rows === 0) return;
				const id = ++jobCounter;
				pendingCallbacks.set(id, (dists, cCols, cRows, rMx, rMy) => {
					if (cCols === cols && cRows === rows) {
						cachedDists = dists;
						cachedMx = rMx;
						cachedMy = rMy;
					}
				});
				distWorker.postMessage({ id, cols, rows, dotSize: DOT_SIZE, mouseX: mx, mouseY: my });
			}

			function resize() {
				if (isMobileOrTouch()) {
					targetProgress = 0;
					progress = 0;
					card.classList.remove('is-pixel-active');
					if (animId) {
						cancelAnimationFrame(animId);
						animId = null;
					}
					ctx!.clearRect(0, 0, w, h);
					return;
				}
				w = card.clientWidth;
				h = card.clientHeight;
				cols = Math.ceil(w / DOT_SIZE);
				rows = Math.ceil(h / DOT_SIZE);
				cachedDists = null;
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				canvas!.width = Math.floor(w * dpr);
				canvas!.height = Math.floor(h * dpr);
				canvas!.style.width = `${w}px`;
				canvas!.style.height = `${h}px`;
				ctx!.setTransform(1, 0, 0, 1, 0, 0);
				ctx!.scale(dpr, dpr);
			}

			resize();
			window.addEventListener('resize', resize, { passive: true });

			function render() {
				// Velocidade bem mais lenta e fluida (~3.5x mais suave)
				const speed = targetProgress === 1 ? 0.032 : 0.045;
				progress += (targetProgress - progress) * speed;

				ctx!.clearRect(0, 0, w, h);

				if (progress > 0.005) {
					ctx!.fillStyle = FILL_COLOR;

					const maxDist = Math.hypot(
						Math.max(mouseX, w - mouseX),
						Math.max(mouseY, h - mouseY)
					);
					const waveRadius = progress * (maxDist + BAND);
					const useCache = cachedDists && Math.abs(cachedMx - mouseX) < 12 && Math.abs(cachedMy - mouseY) < 12;

					for (let r = 0; r < rows; r++) {
						const cy = (r + 0.5) * DOT_SIZE;
						const rowOffset = r * cols;
						for (let col = 0; col < cols; col++) {
							const cx = (col + 0.5) * DOT_SIZE;
							const dist = useCache
								? cachedDists![rowOffset + col]
								: Math.hypot(cx - mouseX, cy - mouseY);

							const rawGrow = (waveRadius - dist) / BAND;
							const grow = Math.max(0, Math.min(1, rawGrow));

							if (grow > 0.001) {
								const smoothGrow = grow * grow * (3 - 2 * grow);

								if (smoothGrow >= 0.999) {
									ctx!.fillRect(col * DOT_SIZE, r * DOT_SIZE, DOT_SIZE, DOT_SIZE);
								} else {
									const size = smoothGrow * DOT_SIZE;
									ctx!.fillRect(cx - size / 2, cy - size / 2, size, size);
								}
							}
						}
					}
				}

				if (Math.abs(targetProgress - progress) > 0.002 || (progress > 0.005 && progress < 0.995)) {
					animId = requestAnimationFrame(render);
				} else {
					progress = targetProgress;
					if (progress === 0) ctx!.clearRect(0, 0, w, h);
					animId = null;
				}
			}

			function startLoop() {
				if (!animId) animId = requestAnimationFrame(render);
			}

			card.addEventListener('mouseenter', (e: MouseEvent) => {
				if (isMobileOrTouch()) return;
				const rect = card.getBoundingClientRect();
				mouseX = e.clientX - rect.left;
				mouseY = e.clientY - rect.top;
				targetProgress = 1;
				card.classList.add('is-pixel-active');
				requestDistanceMap(mouseX, mouseY);
				startLoop();
			});

			card.addEventListener('mousemove', (e: MouseEvent) => {
				if (isMobileOrTouch()) return;
				const rect = card.getBoundingClientRect();
				const nx = e.clientX - rect.left;
				const ny = e.clientY - rect.top;
				mouseX += (nx - mouseX) * 0.12;
				mouseY += (ny - mouseY) * 0.12;
				if (Math.abs(cachedMx - mouseX) >= 24 || Math.abs(cachedMy - mouseY) >= 24) {
					requestDistanceMap(mouseX, mouseY);
				}
				if (targetProgress > 0) startLoop();
			});

			card.addEventListener('mouseleave', () => {
				targetProgress = 0;
				card.classList.remove('is-pixel-active');
				startLoop();
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initWorkEntrance);
	} else {
		initWorkEntrance();
	}

	document.addEventListener('astro:after-swap', initWorkEntrance);
	let lastWorkWinWidth = typeof window !== 'undefined' ? window.innerWidth : 0;
	window.addEventListener('resize', () => {
		if (typeof window !== 'undefined' && window.innerWidth === lastWorkWinWidth) return;
		lastWorkWinWidth = window.innerWidth;
		ScrollTrigger.refresh();
	}, { passive: true });
</script>
