---
// Work.astro — Seção de Projetos inspirada fielmente na referência visual
import TopoField from './ui/topo-field';
import { ScrollTiltedTile } from './ui/scroll-tilted-grid';
import WireframeGlobe from './ui/wireframe-globe';
import About from './About.astro';
interface Project {
	title: string;
	tag: string;
	image: string;
	href: string;
	gridClass: string;
}

interface Props {
	title?: string;
	count?: string;
	projects?: Project[];
}

const defaultProjects: Project[] = [
	{
		title: "CORE VISION",
		tag: "P / 24",
		image: "/images/works/work-1.jpeg",
		href: "#work",
		gridClass: "card-row1-left"
	},
	{
		title: "PHASE 008",
		tag: "P / 24",
		image: "/images/works/work-2.jpeg",
		href: "#work",
		gridClass: "card-row1-right"
	},
	{
		title: "PRIME CONCEPT",
		tag: "P / 24",
		image: "/images/works/work-3.jpeg",
		href: "#work",
		gridClass: "card-row2-left"
	},
	{
		title: "MODERN FLOW",
		tag: "P / 24",
		image: "/images/works/work-4.jpeg",
		href: "#work",
		gridClass: "card-row2-right"
	},
	{
		title: "DUM FRAME",
		tag: "P / 24",
		image: "/images/works/work-5.jpeg",
		href: "#work",
		gridClass: "card-row3-offset"
	}
];

const {
	title = "PROJETOS",
	count = "(05)",
	projects = defaultProjects
} = Astro.props;
---

<section class="work-section" id="work" aria-label="Projetos e Trabalhos Selecionados">
	<!-- Darkening Overlay on Scroll -->
	<div class="work-dark-overlay" aria-hidden="true"></div>

	<!-- Topographic Field Animated WebGL Background -->
	<div class="work-topo-bg" aria-hidden="true">
		<TopoField
			client:load
			mode="light"
			paperColor="#E8E6E0"
			grid={false}
			opacity={0.9}
			speed={0.75}
			density={0.5}
			length={0.65}
			interactive={false}
		/>
	</div>

	<div class="work-container">
		<!-- Título Monumental idêntico à referência visual com revelação letra a letra -->
		<header class="work-header">
			<h2 class="work-title" aria-label={title}>
				{title.split('').map((char, index) => (
					<span class="char-mask" aria-hidden="true">
						<span class="char-inner" style={`--char-idx: ${index}`}>{char === ' ' ? '\u00A0' : char}</span>
					</span>
				))}
			</h2>
		</header>

		<!-- Grid Assimétrico Editorial com 5 Projetos -->
		<div class="projects-grid">
			{projects.map((project, index) => (
				<article class={`project-card ${project.gridClass}`}>
					<a href={project.href} class="project-link" aria-label={`Ver projeto ${project.title}`}>
						<div class="project-image-box">
							<ScrollTiltedTile
								client:load
								src={project.image}
								alt={project.title}
								side={index % 2 === 0 ? "L" : "R"}
								aspectRatio={
									project.gridClass.includes("card-row1-left") || project.gridClass.includes("card-row2-right")
										? "16/10"
										: "16/9.5"
								}
								rounded="12px"
								maxTilt={28}
								maxBlur={4}
								perspective={900}
								variant="editorial"
							/>
						</div>

						<!-- Barra de Metadados Inferior -->
						<div class="project-meta">
							<h3 class="project-name">
								<span class="name-text">{project.title}</span>
								<svg class="name-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="7" y1="17" x2="17" y2="7"></line>
									<polyline points="7 7 17 7 17 17"></polyline>
								</svg>
							</h3>
						</div>
					</a>
				</article>
			))}
		</div>
	</div>

	<!-- Elemento Globo 3D Wireframe Interativo em Rotação com Zoom no Scroll + Seção About Pinned Overlay (Largura 100% direta) -->
	<div class="work-globe-pin-container" id="work-globe-pin">
		<!-- Canvas do Globo Wireframe em Tela Cheia com Resolução Nativa e Zoom Vetorial Contínuo -->
		<div class="work-3d-globe-canvas" id="work-globe-canvas-wrap">
			<WireframeGlobe client:load />
		</div>

		<div class="work-footer-globe-wrap" id="work-globe-wrap">
			<span class="globe-text-label left-label">PEDRO LOURENÇO</span>
			<div class="work-globe-slot" aria-hidden="true"></div>
			<span class="globe-text-label right-label">WEB DESIGNER</span>
		</div>
		<!-- Seção About Pinned Overlay sobreposta ao globo expandido -->
		<About />
	</div>
</section>

<style>
	/* --------------------------------------------------
	 * Estrutura Geral da Seção (Fundo Linho Aquecido)
	 * -------------------------------------------------- */
	.work-section {
		position: relative;
		width: 100%;
		background-color: #E8E6E0;
		--work-text-color: #111215;
		color: var(--work-text-color);
		padding: 0;
		margin: 0;
		box-sizing: border-box;
		overflow: hidden;
	}

	.work-dark-overlay {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background-color: #0e0e0e;
		opacity: 0;
		pointer-events: none;
		z-index: 2;
		will-change: opacity;
	}

	/* --------------------------------------------------
	 * Elemento Globo Wireframe & Pin Container no Final da Seção Work
	 * -------------------------------------------------- */
	.work-globe-pin-container {
		position: relative;
		width: 100%;
		height: 100vh;
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0;
		overflow: hidden;
		z-index: 50;
		background-color: transparent;
	}

	.work-3d-globe-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 25;
		display: block;
	}

	.work-footer-globe-wrap {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 2.5vw, 2rem);
		color: var(--work-text-color, #111215);
		z-index: 20;
	}

	.globe-text-label {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.78rem, 1.1vw, 0.95rem);
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--work-text-color, #111215);
		user-select: none;
		white-space: nowrap;
		will-change: opacity, transform, color;
		width: clamp(140px, 16vw, 190px);
	}

	.globe-text-label.left-label {
		text-align: right;
	}

	.globe-text-label.right-label {
		text-align: left;
	}

	.work-globe-slot {
		width: 5rem;
		height: 3rem;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.work-topo-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		pointer-events: none;
		overflow: hidden;
	}

	.work-container {
		position: relative;
		z-index: 10;
		width: 100%;
		max-width: 1480px;
		margin: 0 auto clamp(4rem, 8vh, 6rem) auto;
		padding: clamp(5.5rem, 11vh, 9.5rem) clamp(1.5rem, 5.5vw, 80px) 0 clamp(1.5rem, 5.5vw, 80px);
		display: flex;
		flex-direction: column;
	}

	/* --------------------------------------------------
	 * Título Monumental: WORK (05) idêntico à referência visual
	 * Proporções naturais do Anton em escala monumental (sem distorção)
	 * -------------------------------------------------- */
	.work-header {
		width: 100%;
		container-type: inline-size;
		margin-bottom: clamp(3.25rem, 6.5vh, 5.25rem);
		user-select: none;
		overflow: visible;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.work-title {
		margin: 0 auto;
		padding: 0.1em 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-weight: 800;
		font-size: clamp(2.5rem, 33.6cqi, 34vw);
		line-height: 1.05;
		letter-spacing: -0.015em;
		text-transform: uppercase;
		color: var(--work-text-color, #111215);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		white-space: nowrap;
		overflow: visible;
	}

	/* Máscara de cada letra com respiro vertical para não cortar glifos */
	.char-mask {
		display: inline-block;
		overflow: hidden;
		vertical-align: middle;
		line-height: 1.05;
		padding: 0.16em 0.02em;
		margin: -0.16em -0.02em;
	}

	.char-inner {
		display: inline-block;
		transform: translateY(135%);
		opacity: 0;
		will-change: transform, opacity;
		line-height: inherit;
	}

	/* --------------------------------------------------
	 * Grid Assimétrico de 12 Colunas
	 * Linha 1: 5 cols / 7 cols
	 * Linha 2: 7 cols / 5 cols
	 * Linha 3: 7 cols (offset à direita)
	 * -------------------------------------------------- */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		column-gap: clamp(0.75rem, 1.25vw, 1.25rem);
		row-gap: clamp(7.5rem, 15vh, 13rem);
		width: 100%;
		align-items: start;
	}

	/* Card 1: Row 1 Esquerda (~42% largura) */
	.card-row1-left {
		grid-column: 1 / 6;
	}

	/* Card 2: Row 1 Direita (~58% largura) */
	.card-row1-right {
		grid-column: 6 / 13;
	}

	/* Card 3: Row 2 Esquerda (~58% largura) */
	.card-row2-left {
		grid-column: 1 / 8;
	}

	/* Card 4: Row 2 Direita (~42% largura) */
	.card-row2-right {
		grid-column: 8 / 13;
	}

	/* Card 5: Row 3 Alinhado à Direita (~58% largura) */
	.card-row3-offset {
		grid-column: 6 / 13;
	}

	/* --------------------------------------------------
	 * Estrutura Individual do Card & Efeitos de Hover
	 * -------------------------------------------------- */
	.project-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		will-change: transform, opacity;
	}

	.project-link {
		display: block;
		text-decoration: none;
		color: inherit;
		outline: none;
		cursor: pointer;
	}

	.project-image-box {
		position: relative;
		width: 100%;
		overflow: visible;
		cursor: pointer;
	}


	/* Barra de Metadados: Título do Projeto + Arrow */
	.project-meta {
		display: flex;
		align-items: center;
		margin-top: 0.95rem;
		padding: 0 0.15rem;
	}

	.project-name {
		margin: 0;
		font-family: 'Rethink Sans', sans-serif;
		font-size: clamp(0.82rem, 1.05vw, 0.95rem);
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--work-text-color, #111215);
		display: inline-flex;
		align-items: center;
		gap: 6px;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-link:hover .project-name {
		transform: translateX(4px);
	}

	.name-arrow {
		color: inherit;
		opacity: 1;
		transform: translate(0, 0);
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
		flex-shrink: 0;
	}

	.project-link:hover .name-arrow {
		transform: translate(3px, -3px);
	}

	@media (max-width: 1200px), (max-width: 1280px) and (orientation: portrait), (hover: none) {
		.project-link:hover .project-name,
		.project-link:active .project-name {
			transform: none !important;
		}

		.project-link:hover .name-arrow,
		.project-link:active .name-arrow {
			transform: none !important;
		}

		.project-card,
		.project-card *,
		.project-image-box,
		.project-image-box * {
			transform: none !important;
			transition: none !important;
		}
	}

	/* --------------------------------------------------
	 * Responsividade (Tablet e Mobile)
	 * -------------------------------------------------- */
	/* Large Tablet / iPad Pro 1032x1376 Breakpoint */
	@media (min-width: 1000px) and (max-width: 1200px),
	       (min-width: 1000px) and (max-width: 1280px) and (orientation: portrait) {
		.work-container {
			max-width: 100%;
			padding-left: clamp(1.25rem, 3vw, 2.25rem);
			padding-right: clamp(1.25rem, 3vw, 2.25rem);
		}

		.projects-grid {
			column-gap: clamp(1rem, 2vw, 1.5rem);
			row-gap: clamp(5.5rem, 9vh, 7.5rem);
		}

		.card-row1-left {
			grid-column: 1 / 7;
		}

		.card-row1-right {
			grid-column: 7 / 13;
		}

		.card-row2-left {
			grid-column: 1 / 8;
		}

		.card-row2-right {
			grid-column: 8 / 13;
		}

		.card-row3-offset {
			grid-column: 5 / 13;
		}

		.project-image-box figure > div {
			aspect-ratio: 16 / 11.2 !important;
		}

		.work-globe-pin-container {
			height: 100vh;
			min-height: 100vh;
		}

		.globe-text-label {
			font-size: clamp(1.2rem, 1.8vw, 1.45rem);
			width: clamp(230px, 25vw, 300px);
			letter-spacing: 0.16em;
		}

		.work-footer-globe-wrap {
			gap: clamp(1.5rem, 3.5vw, 2.5rem);
		}
	}

	@media (max-width: 1024px) {
		.projects-grid {
			column-gap: 1rem;
			row-gap: 6rem;
		}

		.card-row1-left {
			grid-column: 1 / 7;
		}

		.card-row1-right {
			grid-column: 7 / 13;
		}

		.card-row2-left {
			grid-column: 1 / 8;
		}

		.card-row2-right {
			grid-column: 8 / 13;
		}

		.card-row3-offset {
			grid-column: 4 / 13;
		}
	}

	@media (max-width: 768px) {
		.work-section {
			padding: 0;
		}

		.work-container {
			padding: clamp(2.25rem, 5vh, 3.25rem) clamp(0.65rem, 2.5vw, 1rem) 0 clamp(0.65rem, 2.5vw, 1rem);
			margin: 0 auto clamp(2.5rem, 5vh, 3.5rem) auto;
		}

		.work-header {
			margin-bottom: clamp(1.75rem, 4vh, 2.5rem);
		}

		.projects-grid {
			display: flex;
			flex-direction: column;
			gap: clamp(3rem, 6vh, 4rem);
			width: 100%;
		}

		.project-card {
			width: 100%;
			max-width: 100%;
		}

		/* Centralização e altura equilibrada no mobile */
		.work-globe-pin-container {
			width: 100%;
			max-width: 100vw;
			height: 122vh;
			min-height: 122vh;
			overflow: visible;
		}

		/* Telas mobile mais altas (ex: 393x852 iPhone 14/15/16 Pro, 412x915 Pixel/Galaxy) */
		@media (min-height: 820px) {
			.work-globe-pin-container {
				height: 108vh;
				min-height: 108vh;
			}
		}

		@media (min-height: 880px) {
			.work-globe-pin-container {
				height: 104vh;
				min-height: 104vh;
			}
		}

		.work-footer-globe-wrap {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			justify-items: center;
			width: 100%;
			max-width: 100%;
			box-sizing: border-box;
			padding: 0 clamp(0.5rem, 2vw, 1rem);
			margin: 0 auto;
		}

		.globe-text-label {
			font-size: clamp(0.72rem, 2.75vw, 0.85rem);
			letter-spacing: 0.07em;
			width: 100%;
			max-width: 100%;
		}

		.globe-text-label.left-label {
			text-align: right;
			justify-self: end;
			padding-right: clamp(0.35rem, 1.6vw, 0.65rem);
		}

		.globe-text-label.right-label {
			text-align: left;
			justify-self: start;
			padding-left: clamp(0.35rem, 1.6vw, 0.65rem);
		}

		.work-globe-slot {
			width: 76px;
			height: 44px;
			flex-shrink: 0;
			justify-self: center;
		}
	}

	/* --------------------------------------------------
	 * Accessibility: respect reduced motion preference
	 * -------------------------------------------------- */
	@media (prefers-reduced-motion: reduce) {
		.project-card {
			will-change: auto !important;
			transform: none !important;
			opacity: 1 !important;
		}

		.char-inner {
			transform: none !important;
			opacity: 1 !important;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function fitWorkTitle() {
		const header = document.querySelector('.work-header') as HTMLElement | null;
		const title = document.querySelector('.work-title') as HTMLElement | null;
		if (!header || !title) return;

		// Set a baseline test font-size to measure exact unconstrained proportions
		const testSize = 100;
		title.style.fontSize = `${testSize}px`;
		const targetWidth = header.clientWidth;
		const currentWidth = title.scrollWidth;

		if (targetWidth > 0 && currentWidth > 0) {
			const optimalSize = (targetWidth / currentWidth) * testSize * 0.99;
			title.style.fontSize = `${optimalSize}px`;
		}
	}

	function animateWorkTitle() {
		// Accessibility: respect reduced motion
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set('.char-inner', { y: '0%', opacity: 1 });
			return;
		}

		ScrollTrigger.getById('work-title-trigger')?.kill();

		gsap.fromTo(
			'.char-inner',
			{
				y: '135%',
				opacity: 0,
			},
			{
				y: '0%',
				opacity: 1,
				duration: 0.95,
				stagger: 0.1,
				ease: 'expo.out',
				scrollTrigger: {
					id: 'work-title-trigger',
					trigger: '.work-header',
					start: 'top 85%',
					toggleActions: 'play none none reverse',
				},
			}
		);
	}



	function animateGlobeZoomTransition() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set('.about-section', { autoAlpha: 1, pointerEvents: 'auto', clipPath: 'none' });
			return;
		}

		ScrollTrigger.getById('globe-zoom-pin-trigger')?.kill();

		const pinTarget = document.getElementById('work-globe-pin');
		if (!pinTarget) return;

		gsap.set('.globe-text-label', { autoAlpha: 1, scale: 1, x: 0 });
		gsap.set('.about-section', {
			autoAlpha: 0,
			pointerEvents: 'none',
		});
		gsap.set('#work-globe-pin', {
			backgroundColor: 'transparent',
		});

		const tl = gsap.timeline({
			scrollTrigger: {
				id: 'globe-zoom-pin-trigger',
				trigger: pinTarget,
				start: 'top top',
				end: '+=85%',
				pin: true,
				pinSpacing: true,
				anticipatePin: 0,
				scrub: true,
				onUpdate: (self) => {
					if (typeof (window as any).setGlobeScrollProgress === 'function') {
						(window as any).setGlobeScrollProgress(self.progress);
					}
					if (self.progress >= 0.75) {
						if (typeof (window as any).playAboutEntrance === 'function') {
							(window as any).playAboutEntrance();
						}
					} else if (self.progress < 0.35) {
						if (typeof (window as any).resetAboutEntrance === 'function') {
							(window as any).resetAboutEntrance();
						}
					}
				},
			},
		});

		// 1. Textos laterais desaparecem imediatamente assim que o globo começa a dar zoom (0.0 -> 0.05)
		tl.to('.globe-text-label.left-label', {
			autoAlpha: 0,
			x: -25,
			scale: 0.95,
			duration: 0.05,
			ease: 'power2.out',
		}, 0);

		tl.to('.globe-text-label.right-label', {
			autoAlpha: 0,
			x: 25,
			scale: 0.95,
			duration: 0.05,
			ease: 'power2.out',
		}, 0);

		// 2. Transição contínua para o fundo branco puro sem piscar e sem vazamento escuro (0.40 -> 0.70)
		tl.to('#work-globe-pin', {
			backgroundColor: '#FFFFFF',
			duration: 0.30,
			ease: 'power1.inOut',
		}, 0.40);

		tl.to('.about-section', {
			autoAlpha: 1,
			pointerEvents: 'auto',
			duration: 0.30,
			ease: 'power1.inOut',
		}, 0.40);

		tl.to('.work-3d-globe-canvas', {
			autoAlpha: 0,
			duration: 0.15,
			ease: 'power1.out',
		}, 0.65);

		// Se a página já carregar ou atualizar com scroll acima de 0.75
		const pinTrigger = ScrollTrigger.getById('globe-zoom-pin-trigger');
		if (pinTrigger && pinTrigger.progress >= 0.75) {
			gsap.set('#work-globe-pin', { backgroundColor: '#FFFFFF' });
			gsap.set('.about-section', { autoAlpha: 1, pointerEvents: 'auto' });
			(window as any).playAboutEntrance?.();
		}
	}

	function animateProjectCardsFade() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		ScrollTrigger.getById('project-cards-fade-grid')?.kill();

		// Smooth fade of project grid as user approaches globe (delayed so Card 5 stays fully visible)
		gsap.to('.projects-grid', {
			opacity: 0,
			y: -35,
			ease: 'none',
			scrollTrigger: {
				id: 'project-cards-fade-grid',
				trigger: '#work-globe-pin',
				start: 'top 30%',
				end: 'top top',
				scrub: 0.4,
			},
		});
	}

	function animateProjectNamesScroll() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		// Clean up existing name fade triggers
		ScrollTrigger.getAll().forEach((st) => {
			if (st.vars.id && st.vars.id.startsWith('name-fade-')) {
				st.kill();
			}
		});

		const isMobile = window.innerWidth <= 640;

		if (!isMobile) {
			// Desktop: 3 Linhas assimétricas
			// 1. Ao rolar para a Linha 2 (Cards 3 e 4), os nomes da Linha 1 (Cards 1 e 2) somem
			const row1Metas = document.querySelectorAll('.card-row1-left .project-meta, .card-row1-right .project-meta');
			const row2Card = document.querySelector('.card-row2-left');
			if (row1Metas.length && row2Card) {
				gsap.to(row1Metas, {
					opacity: 0,
					y: -12,
					ease: 'none',
					scrollTrigger: {
						id: 'name-fade-row1',
						trigger: row2Card,
						start: 'top 85%',
						end: 'top 55%',
						scrub: 0.3,
					},
				});
			}

			// 2. Ao rolar para a Linha 3 (Card 5), os nomes de cima da Linha 2 (Cards 3 e 4) somem
			const row2Metas = document.querySelectorAll('.card-row2-left .project-meta, .card-row2-right .project-meta');
			const row3Card = document.querySelector('.card-row3-offset');
			if (row2Metas.length && row3Card) {
				gsap.to(row2Metas, {
					opacity: 0,
					y: -12,
					ease: 'none',
					scrollTrigger: {
						id: 'name-fade-row2',
						trigger: row3Card,
						start: 'top 85%',
						end: 'top 55%',
						scrub: 0.3,
					},
				});
			}

			// 3. Ao rolar para o Globo / Rodapé, o nome do Card 5 some
			const row3Meta = document.querySelector('.card-row3-offset .project-meta');
			const globeTarget = document.getElementById('work-globe-pin');
			if (row3Meta && globeTarget) {
				gsap.to(row3Meta, {
					opacity: 0,
					y: -12,
					ease: 'none',
					scrollTrigger: {
						id: 'name-fade-row3',
						trigger: globeTarget,
						start: 'top 85%',
						end: 'top 55%',
						scrub: 0.3,
					},
				});
			}
		} else {
			// Mobile: Lista vertical card a card
			const cards = Array.from(document.querySelectorAll('.project-card'));
			cards.forEach((card, idx) => {
				const meta = card.querySelector('.project-meta');
				const nextTarget = idx < cards.length - 1 ? cards[idx + 1] : document.getElementById('work-globe-pin');
				if (meta && nextTarget) {
					gsap.to(meta, {
						opacity: 0,
						y: -12,
						ease: 'none',
						scrollTrigger: {
							id: `name-fade-mobile-${idx}`,
							trigger: nextTarget,
							start: 'top 85%',
							end: 'top 55%',
							scrub: 0.3,
						},
					});
				}
			});
		}
	}

	function animateWorkDarkening() {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		ScrollTrigger.getById('work-darkening-overlay')?.kill();
		ScrollTrigger.getById('work-darkening-text')?.kill();

		gsap.to('.work-dark-overlay', {
			opacity: 0.95,
			ease: 'none',
			scrollTrigger: {
				id: 'work-darkening-overlay',
				trigger: '.work-header',
				start: 'bottom top',
				endTrigger: '.work-section',
				end: 'bottom bottom-=10%',
				scrub: 0.5,
			},
		});

		gsap.to(['.work-title-big', '.project-name', '.globe-text-label'], {
			color: '#FFFFFF',
			ease: 'power2.in',
			scrollTrigger: {
				id: 'work-darkening-text',
				trigger: '.work-header',
				start: 'bottom top',
				endTrigger: '.projects-grid',
				end: 'bottom 80%',
				scrub: 0.3,
			},
		});
	}

	function initWorkHeader() {
		fitWorkTitle();
		animateWorkTitle();
		animateWorkDarkening();
		animateProjectCardsFade();
		animateProjectNamesScroll();
		animateGlobeZoomTransition();
	}

	let workHeaderInitialized = false;
	function initOnce() {
		if (workHeaderInitialized) return;
		workHeaderInitialized = true;
		initWorkHeader();
		ScrollTrigger.refresh();
	}

	if (typeof window !== 'undefined') {
		if (document.fonts) {
			document.fonts.ready.then(initOnce);
		} else {
			initOnce();
		}
		window.addEventListener('resize', () => {
			fitWorkTitle();
			ScrollTrigger.refresh();
		});
		document.addEventListener('astro:after-swap', () => {
			workHeaderInitialized = false;
			initOnce();
		});
	}
</script>
