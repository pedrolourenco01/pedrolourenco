---
// SitePreloader.astro — Intro refinada: "PEDRO LOURENÇO" em escala editorial elegante com revelação letra a letra
const title = "PEDRO LOURENÇO";
---

<div class="site-preloader" id="site-preloader" aria-hidden="true">
	<div class="preloader-content">
		<h1 class="intro-title" aria-label={title}>
			{title.split('').map((char, index) => (
				<span class={`intro-char-mask ${char === ' ' ? 'char-space' : ''}`} aria-hidden="true">
					<span class="intro-char-inner" style={`--char-idx: ${index}`}>
						{char === ' ' ? '\u00A0' : char}
					</span>
				</span>
			))}
		</h1>
	</div>
</div>

<style>
	.site-preloader {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100svh;
		z-index: 99999;
		background-color: #000000;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: all;
		overflow: hidden;
		user-select: none;
		will-change: transform;
	}

	.preloader-content {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(1.25rem, 5vw, 3rem);
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
	}

	/* Texto proporcional e equilibrado no centro do canvas preto */
	.intro-title {
		margin: 0 auto;
		padding: 0.1em 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-weight: 800;
		font-size: clamp(1.75rem, 3.8vw, 3.6rem);
		line-height: 1.1;
		letter-spacing: -0.018em;
		text-transform: uppercase;
		color: #FFFFFF;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		white-space: nowrap;
		overflow: visible;
		transform: scaleY(1.2);
		transform-origin: center;
		will-change: transform;
	}

	/* Máscara de cada letra com respiro vertical para não cortar glifos */
	.intro-char-mask {
		display: inline-block;
		overflow: hidden;
		vertical-align: middle;
		line-height: 1.1;
		padding: 0.18em 0.02em;
		margin: -0.18em -0.02em;
	}

	/* Espaço proporcional e equilibrado entre as palavras */
	.char-space {
		width: clamp(0.45rem, 1.1vw, 1rem);
		display: inline-block;
	}

	.intro-char-inner {
		display: inline-block;
		transform: translateY(135%);
		opacity: 0;
		will-change: transform, opacity;
		line-height: inherit;
	}

	@media (max-width: 640px) {
		.intro-title {
			font-size: clamp(1.35rem, 5.8vw, 1.95rem);
		}

		.char-space {
			width: 0.45rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function fitIntroTitle() {
		const content = document.querySelector('.preloader-content') as HTMLElement | null;
		const title = document.querySelector('.intro-title') as HTMLElement | null;
		if (!content || !title) return;

		// Em telas ultra compactas, apenas evita quebra de linha mantendo a proporção
		const maxWidth = content.clientWidth * 0.94;
		if (title.scrollWidth > maxWidth && maxWidth > 0) {
			const scale = maxWidth / title.scrollWidth;
			title.style.transform = `scale(${scale * 0.98}) scaleY(1.2)`;
		} else {
			title.style.transform = 'scaleY(1.2)';
		}
	}

	function runIntro() {
		const preloader = document.getElementById('site-preloader');
		if (!preloader) return;

		// 1. Trava a rolagem da página durante a reprodução da intro
		document.body.style.overflow = 'hidden';
		if ((window as any).lenis) {
			try {
				(window as any).lenis.stop();
			} catch (e) {}
		}

		// Garante que o Hero permaneça pausado no estado inicial
		document.body.classList.remove('hero-loaded');

		// Garante dimensões proporcionais
		fitIntroTitle();

		// Acessibilidade: respeita quem prefere movimento reduzido
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			document.body.classList.add('hero-loaded');
			document.body.style.overflow = '';
			if ((window as any).lenis) {
				try {
					(window as any).lenis.start();
				} catch (e) {}
			}
			preloader.style.display = 'none';
			ScrollTrigger.refresh();
			return;
		}

		const tl = gsap.timeline();

		// 1. Animação de entrada idêntica a PROJETOS: letras sobem de 135% com expo.out e stagger
		tl.fromTo(
			'.intro-char-inner',
			{
				y: '135%',
				opacity: 0,
			},
			{
				y: '0%',
				opacity: 1,
				duration: 0.95,
				stagger: 0.045,
				ease: 'expo.out',
			},
			0.15
		);

		// 2. Transição cinematográfica: o background preto sobe (translateY: -100%)
		// e a Hero inicia sua animação de entrada exatamente quando a cortina começa a subir!
		tl.to(
			preloader,
			{
				yPercent: -100,
				duration: 1.15,
				ease: 'power4.inOut',
				onStart: () => {
					// Dispara as animações de entrada da Hero enquanto o background está subindo
					document.body.classList.add('hero-loaded');
				},
				onComplete: () => {
					// Libera o scroll e reativa a rolagem suave do Lenis
					document.body.style.overflow = '';
					if ((window as any).lenis) {
						try {
							(window as any).lenis.start();
						} catch (e) {}
					}
					preloader.style.display = 'none';
					// Atualiza os pontos de rolagem das demais seções com a página liberada
					ScrollTrigger.refresh();
				},
			},
			'+=0.45'
		);

		// Efeito sutil de aceleração no texto subindo com a cortina
		tl.to(
			'.intro-title',
			{
				y: -30,
				opacity: 0.9,
				duration: 0.8,
				ease: 'power3.in',
			},
			'<0.05'
		);
	}

	let introInitialized = false;
	function initIntroOnce() {
		if (introInitialized) return;
		introInitialized = true;

		if (document.fonts) {
			document.fonts.ready.then(() => {
				fitIntroTitle();
				runIntro();
			});
		} else {
			fitIntroTitle();
			runIntro();
		}

		window.addEventListener('resize', () => {
			fitIntroTitle();
		});
	}

	if (typeof window !== 'undefined') {
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initIntroOnce);
		} else {
			initIntroOnce();
		}
		document.addEventListener('astro:after-swap', () => {
			introInitialized = false;
			initIntroOnce();
		});
	}
</script>
