---
// About.astro — Seção Sobre Mim fiel à referência com a fonte oficial do site (Rethink Sans)
import Button from './Button.astro';
import { SlideUpText } from './ui/slide-up-text';

interface Props {
	headline?: string;
	headlineEn?: string;
	paragraph1Pt?: string;
	paragraph1En?: string;
	paragraph2Pt?: string;
	paragraph2En?: string;
	paragraphs?: string[];
	imageSrc?: string;
	portraitImage?: string;
	imageAlt?: string;
	buttonText?: string;
	buttonTextEn?: string;
	buttonHref?: string;
}

const defaultHeadline = "Oi, sou Pedro, web designer. Gosto de transformar ideias em websites que combinam estética, simplicidade e funcionalidade. Meu foco está em criar interfaces bem pensadas, com personalidade e atenção aos detalhes.";
const defaultHeadlineEn = "Hi, I'm Pedro, web designer. I like to turn ideas into websites that combine aesthetics, simplicity, and functionality. My focus is on creating thoughtful interfaces, with personality and attention to detail.";

const defaultParagraph1Pt = "Meu interesse por design começou com meu irmão, foi com ele que aprendi os primeiros conceitos e descobri esse universo. Com o tempo, fui explorando novas ferramentas, desenvolvendo meu próprio estilo e encontrando no web design uma forma de unir criatividade e tecnologia.";
const defaultParagraph1En = "My interest in design began with my brother; it was through him that I learned the core concepts and discovered this universe. Over time, I explored new tools, developed my own style, and found in web design a way to unite creativity and technology.";

const defaultParagraph2Pt = "Desde então, sigo aprendendo e buscando evoluir a cada projeto. Gosto de explorar referências, experimentar novas ideias e entender como cada detalhe pode fazer a diferença. Para mim, o design é um processo constante de aprendizado, prática e descoberta.";
const defaultParagraph2En = "Since then, I continuously learn and strive to evolve with every project. I enjoy exploring fresh references, experimenting with bold ideas, and understanding how subtle details make a lasting impact. To me, design is an ongoing journey of learning, practice, and discovery.";

const {
	headline = defaultHeadline,
	headlineEn = defaultHeadlineEn,
	paragraph1Pt = defaultParagraph1Pt,
	paragraph1En = defaultParagraph1En,
	paragraph2Pt = defaultParagraph2Pt,
	paragraph2En = defaultParagraph2En,
	paragraphs,
	imageSrc = "/images/about-pedro.jpeg",
	portraitImage,
	imageAlt = "Pedro Lourenço — Web Designer e Desenvolvedor",
	buttonText = "Entrar em contato",
	buttonTextEn = "Get in touch",
	buttonHref = "https://wa.me/5521971341163"
} = Astro.props;
---

<section class="about-section" id="about" aria-label="Sobre Pedro Lourenço">
	<div class="about-container">
		<!-- 1. Texto em cima em destaque absoluto pegando a largura toda da seção com animação SlideUpText (Fiel à referência Kai Marlow em 3 Linhas) -->
		<div class="about-headline-wrap">
			<!-- Versão PT -->
			<div class="lang-pt">
				<!-- Desktop: 3 Linhas perfeitamente balanceadas pegando a largura toda da seção -->
				<h2 class="about-headline about-headline-desktop">
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.0} text="Oi, sou Pedro, web designer. Gosto de transformar ideias em websites">
							Oi, sou Pedro, web designer. Gosto de transformar ideias em websites
						</SlideUpText>
					</div>
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.08} text="que combinam estética, simplicidade e funcionalidade. Meu foco está em">
							que combinam estética, simplicidade e funcionalidade. Meu foco está em
						</SlideUpText>
					</div>
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.16} text="criar interfaces bem pensadas, com personalidade e atenção aos detalhes.">
							criar interfaces bem pensadas, com personalidade e atenção aos detalhes.
						</SlideUpText>
					</div>
				</h2>

				<!-- Mobile: Fluida -->
				<h2 class="about-headline about-headline-mobile">
					<SlideUpText client:visible inView split="words" stagger={0.025} text={headline}>
						{headline}
					</SlideUpText>
				</h2>
			</div>

			<!-- Versão EN -->
			<div class="lang-en">
				<!-- Desktop: 3 Linhas perfeitamente balanceadas em inglês -->
				<h2 class="about-headline about-headline-desktop">
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.0} text="Hi, I'm Pedro, web designer. I like to turn ideas into websites that">
							Hi, I'm Pedro, web designer. I like to turn ideas into websites that
						</SlideUpText>
					</div>
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.08} text="combine aesthetics, simplicity, and functionality. My focus is on">
							combine aesthetics, simplicity, and functionality. My focus is on
						</SlideUpText>
					</div>
					<div class="about-headline-row">
						<SlideUpText client:visible inView split="words" stagger={0.016} delay={0.16} text="creating thoughtful interfaces, with personality and attention to detail.">
							creating thoughtful interfaces, with personality and attention to detail.
						</SlideUpText>
					</div>
				</h2>

				<!-- Mobile: Fluida -->
				<h2 class="about-headline about-headline-mobile">
					<SlideUpText client:visible inView split="words" stagger={0.025} text={headlineEn}>
						{headlineEn}
					</SlideUpText>
				</h2>
			</div>
		</div>

		<!-- 2. Grid inferior na largura da hero: foto mais próxima do texto e cantos arredondados iguais ao botão -->
		<div class="about-bottom-grid">
			<!-- Coluna 1: Espaço Negativo Editorial -->
			<div class="about-spacer-col" aria-hidden="true"></div>

			<!-- Coluna 2: Retrato Fotográfico Preto e Branco (Pontas iguais ao botão: 8px) -->
			<div class="about-media-col">
				<div class="about-image-card">
					{portraitImage ? (
						<img
							src={portraitImage}
							alt={imageAlt}
							class="about-portrait-img"
							loading="lazy"
							decoding="async"
							width="1200"
							height="896"
						/>
					) : (
						<picture style="display: contents;">
							<source
								type="image/avif"
								srcset="/images/optimized/about-pedro-640.avif 640w, /images/optimized/about-pedro-1000.avif 1000w"
								sizes="(max-width: 900px) 100vw, 40vw"
							/>
							<source
								type="image/webp"
								srcset="/images/optimized/about-pedro-640.webp 640w, /images/optimized/about-pedro-1000.webp 1000w"
								sizes="(max-width: 900px) 100vw, 40vw"
							/>
							<img
								src="/images/optimized/about-pedro-1000.jpg"
								alt={imageAlt}
								class="about-portrait-img"
								loading="lazy"
								decoding="async"
								width="1200"
								height="896"
							/>
						</picture>
					)}
				</div>
			</div>

			<!-- Coluna 3: Textos Editoriais e Botão por último -->
			<div class="about-content-col">
				<!-- Versão PT -->
				<div class="lang-pt">
					<div class="about-text-content">
						<SlideUpText
							client:visible
							inView
							split="words"
							stagger={0.018}
							delay={0.15}
							className="about-description"
						>
							{paragraph1Pt}
						</SlideUpText>
						<SlideUpText
							client:visible
							inView
							split="words"
							stagger={0.018}
							delay={0.27}
							className="about-description"
						>
							{paragraph2Pt}
						</SlideUpText>
					</div>

					<div class="about-action-wrap">
						<Button href={buttonHref} target="_blank" rel="noopener noreferrer" id="about-cta-btn-pt">
							{buttonText}
						</Button>
					</div>
				</div>

				<!-- Versão EN -->
				<div class="lang-en">
					<div class="about-text-content">
						<SlideUpText
							client:visible
							inView
							split="words"
							stagger={0.018}
							delay={0.15}
							className="about-description"
						>
							{paragraph1En}
						</SlideUpText>
						<SlideUpText
							client:visible
							inView
							split="words"
							stagger={0.018}
							delay={0.27}
							className="about-description"
						>
							{paragraph2En}
						</SlideUpText>
					</div>

					<div class="about-action-wrap">
						<Button href={buttonHref} target="_blank" rel="noopener noreferrer" id="about-cta-btn-en">
							{buttonTextEn}
						</Button>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* --------------------------------------------------
	 * Estrutura Geral da Seção (Fundo Claro #E8E6E0)
	 * -------------------------------------------------- */
	.about-section {
		position: relative;
		width: 100%;
		background-color: transparent;
		color: #111215;
		margin: 0;
		padding: clamp(5.5rem, 10vh, 9rem) 0 clamp(6rem, 11vh, 10rem) 0;
		box-sizing: border-box;
		overflow: hidden;
		z-index: 20;
	}

	/* --------------------------------------------------
	 * Container com a mesma largura exata da Hero
	 * -------------------------------------------------- */
	.about-container {
		position: relative;
		width: 100%;
		max-width: 1920px;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 4.5rem);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vh, 5rem);
	}

	/* --------------------------------------------------
	 * Texto em Cima (Fonte Oficial do Site: Rethink Sans - 3 Linhas Monumentais De Ponta a Ponta)
	 * -------------------------------------------------- */
	.about-headline-wrap {
		width: 100%;
		max-width: 100%;
		container-type: inline-size;
		overflow: visible;
	}

	.about-headline {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(2.2rem, 3.75vw, 5.2rem);
		font-size: clamp(2.2rem, 3.82cqi, 5.2rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.024em;
		color: #111215;
		margin: 0;
		padding: 0;
		width: 100%;
		max-width: 100%;
		will-change: transform, opacity;
	}

	.about-headline-desktop {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: 0.1em;
	}

	.about-headline-mobile {
		display: none;
	}

	.about-headline-row {
		display: block;
		width: 100%;
		white-space: nowrap;
	}

	.about-headline-row :global(.flex) {
		display: inline-flex !important;
		flex-wrap: nowrap !important;
		white-space: nowrap !important;
	}

	/* --------------------------------------------------
	 * Grid Inferior: Spacer + Foto + Texto com espaçamento reduzido
	 * -------------------------------------------------- */
	.about-bottom-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, clamp(420px, 38vw, 620px));
		column-gap: clamp(1rem, 1.6vw, 1.85rem);
		row-gap: 2rem;
		align-items: start;
		width: 100%;
	}

	/* Coluna 1: Espaço Vazio Editorial */
	.about-spacer-col {
		width: 100%;
		height: 100%;
	}

	/* Coluna 2: Retrato Fotográfico Preto e Branco */
	.about-media-col {
		width: auto;
		display: flex;
		justify-content: flex-start;
	}

	.about-image-card {
		position: relative;
		width: clamp(280px, 24vw, 420px);
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 0; /* Pontas quadradas iguais ao do botão */
		background-color: #d6d3cc;
		will-change: transform, opacity, clip-path;
	}

	.about-portrait-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 52% 20%;
		display: block;
		border-radius: 0; /* Pontas quadradas iguais ao do botão */
		filter: grayscale(100%) contrast(1.12) brightness(0.96);
		transform: scale(1.04);
		transform-origin: center center;
		will-change: transform, filter;
	}

	/* Coluna 3: Texto e Botão */
	.about-content-col {
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
		padding-top: 0;
	}

	.about-text-content {
		display: flex;
		flex-direction: column;
		gap: clamp(1.25rem, 2vh, 1.75rem);
		margin-bottom: clamp(1.75rem, 3.2vh, 2.5rem);
	}

	.about-description {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.92rem, 1.05vw, 1.12rem);
		font-weight: 450;
		text-transform: none;
		letter-spacing: -0.012em;
		line-height: 1.65;
		color: rgba(17, 18, 21, 0.82);
		margin: 0;
		will-change: transform, opacity;
	}

	.about-action-wrap {
		display: inline-block;
		will-change: transform, opacity;
	}

	/* --------------------------------------------------
	 * Responsividade (Tablet e Mobile)
	 * -------------------------------------------------- */
	@media (max-width: 1024px) {
		.about-headline-desktop {
			display: none;
		}

		.about-headline-mobile {
			display: block;
			text-wrap: balance;
		}
	}

	@media (max-width: 1100px) {
		.about-spacer-col {
			display: none;
		}

		.about-bottom-grid {
			grid-template-columns: auto minmax(0, 1fr);
			column-gap: clamp(1rem, 1.6vw, 1.85rem);
		}
	}

	@media (max-width: 768px) {
		.about-section {
			padding: clamp(3.5rem, 7vh, 5rem) 0;
		}

		.about-container {
			gap: 2.5rem;
		}

		.about-headline {
			font-size: clamp(1.85rem, 7vw, 2.65rem);
			line-height: 1.15;
			letter-spacing: -0.03em;
		}

		.about-bottom-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.about-media-col,
		.about-content-col {
			grid-column: 1 / -1;
		}

		.about-image-card {
			max-width: 100%;
			aspect-ratio: 4 / 5;
		}

		.about-description {
			font-size: 0.95rem;
			line-height: 1.62;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	let aboutST: ScrollTrigger | null = null;
	let aboutTimeline: gsap.core.Timeline | null = null;
	let headlineResizeObserver: ResizeObserver | null = null;

	function fitAboutHeadline() {
		const wrap = document.querySelector('.about-headline-wrap') as HTMLElement | null;
		if (!wrap) return;
		if (window.innerWidth <= 1024) {
			const rows = document.querySelectorAll('.about-headline-desktop .about-headline-row');
			rows.forEach((row) => ((row as HTMLElement).style.fontSize = ''));
			return;
		}

		const containerWidth = wrap.getBoundingClientRect().width;
		if (!containerWidth) return;

		const rows = document.querySelectorAll('.about-headline-desktop .about-headline-row');
		rows.forEach((row) => {
			const el = row as HTMLElement;
			if (el.offsetParent === null) return;

			el.style.fontSize = '';
			const currentWidth = el.scrollWidth;
			if (currentWidth > 0) {
				const currentFontSize = parseFloat(window.getComputedStyle(el).fontSize);
				const idealFontSize = (containerWidth / currentWidth) * currentFontSize;
				el.style.fontSize = `${idealFontSize.toFixed(2)}px`;
			}
		});
	}

	function setupHeadlineObserver() {
		if (window.innerWidth <= 1024) return;
		const wrap = document.querySelector('.about-headline-wrap') as HTMLElement | null;
		if (!wrap) return;
		if (headlineResizeObserver) {
			headlineResizeObserver.disconnect();
		}
		if (typeof ResizeObserver !== 'undefined') {
			headlineResizeObserver = new ResizeObserver(() => {
				if (window.innerWidth > 1024) {
					fitAboutHeadline();
				}
			});
			headlineResizeObserver.observe(wrap);
		}
	}

	function initAboutEntrance() {
		if (aboutST) {
			aboutST.kill();
			aboutST = null;
		}
		if (aboutTimeline) {
			aboutTimeline.kill();
			aboutTimeline = null;
		}

		const imgCard = document.querySelector('.about-image-card') as HTMLElement | null;
		const portraitImg = document.querySelector('.about-portrait-img') as HTMLElement | null;
		const actionWraps = document.querySelectorAll('.about-action-wrap');

		if (!imgCard || !portraitImg) return;

		// Acessibilidade: movimento reduzido
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set(imgCard, { opacity: 1, y: 0, clipPath: 'none' });
			gsap.set(portraitImg, { scale: 1.04, filter: 'grayscale(100%) contrast(1.12) brightness(0.96)' });
			actionWraps.forEach((el) => gsap.set(el, { opacity: 1, y: 0 }));
			return;
		}

		// Estado inicial cinematográfico para revelação da foto no viewport
		gsap.set(imgCard, {
			opacity: 0,
			y: 55,
			clipPath: 'inset(16% 0% 0% 0% round 8px)'
		});
		gsap.set(portraitImg, {
			scale: 1.25,
			filter: 'grayscale(100%) contrast(1.15) brightness(0.85)'
		});
		actionWraps.forEach((el) => gsap.set(el, { opacity: 0, y: 24 }));

		const tl = gsap.timeline({
			paused: true,
			defaults: { ease: 'power3.out' }
		});

		tl.to(imgCard, {
			opacity: 1,
			y: 0,
			clipPath: 'inset(0% 0% 0% 0% round 8px)',
			duration: 1.15,
			ease: 'power3.out'
		}, 0)
		.to(portraitImg, {
			scale: 1.04,
			filter: 'grayscale(100%) contrast(1.12) brightness(0.96)',
			duration: 1.45,
			ease: 'power3.out'
		}, 0)
		.to(actionWraps, {
			opacity: 1,
			y: 0,
			duration: 0.75,
			ease: 'power3.out'
		}, 0.25);

		aboutTimeline = tl;

		// Dispara a animação diretamente no scroll ao atingir a foto (top 85% do viewport)
		aboutST = ScrollTrigger.create({
			id: 'about-photo-reveal',
			trigger: imgCard,
			start: 'top 85%',
			onEnter: () => tl.play(),
			onLeaveBack: () => tl.reverse()
		});

		// Verificação caso o usuário já esteja com o scroll nessa posição
		const r = imgCard.getBoundingClientRect();
		if (r.top < window.innerHeight * 0.85 && r.bottom > 0) {
			tl.play();
		}
	}

	function setupAboutComponent() {
		initAboutEntrance();
		setupHeadlineObserver();
		fitAboutHeadline();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupAboutComponent);
	} else {
		setupAboutComponent();
	}

	if (typeof document !== 'undefined' && (document as any).fonts) {
		(document as any).fonts.ready.then(() => {
			fitAboutHeadline();
		});
	}

	document.addEventListener('astro:after-swap', setupAboutComponent);
	window.addEventListener('resize', () => {
		fitAboutHeadline();
		ScrollTrigger.refresh();
	});
	window.addEventListener('portfolio:language-change', () => {
		setTimeout(fitAboutHeadline, 30);
	});
</script>
