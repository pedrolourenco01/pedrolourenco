---
// Button.astro — Componente oficial de botão com efeito Pixel-Broke
import { Button03 } from './ui/pixel-broke-button';

interface Props {
	href?: string;
	id?: string;
	class?: string;
	text?: string;
	variant?: 'orange' | 'dark';
	style?: Record<string, any>;
	[key: string]: any;
}

const {
	href = "https://wa.me/5521971341163",
	id = "main-cta-btn",
	class: className = "",
	text,
	variant = "orange",
	style = {},
	...rest
} = Astro.props;

// Renderiza o slot default para extrair o texto limpo se disponível
let slotText = "";
if (Astro.slots.has('default')) {
	const rendered = await Astro.slots.render('default');
	slotText = rendered.replace(/<[^>]*>?/gm, '').trim();
}

const finalLabel = text || slotText || "Entrar em contato";
---

<Button03
	client:load
	id={id}
	href={href}
	className={className}
	variant={variant}
	text={finalLabel}
	style={style}
	{...rest}
>
	{finalLabel}
</Button03>
