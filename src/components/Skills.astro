---
// Skills.astro — Seção de Habilidades
import Button from './Button.astro';
import { SlideUpText } from './ui/slide-up-text';

interface Props {
	headlinePrefix?: string;
	headlineAccent?: string;
	headlineSuffix?: string;
	description?: string;
	ctaText?: string;
}

const {
	headlinePrefix = "I am a ",
	headlineAccent = "web designer working with brands and founders to bring ideas to life.",
	headlineSuffix = " My focus is on crafting clear interfaces, solving problems with simplicity, and obsessing over the details across every project.",
	description = "I work from initial concept to the final build, crafting websites and visual identities with genuine attention to what matters. I value straightforward processes, thoughtful decisions, and well-executed work.",
	ctaText = "View Projects"
} = Astro.props;
---

<section class="skills-section" id="skills" data-header-theme="dark" aria-label="Skills & Introduction">
	<div class="skills-container">
		<!-- Bloco do Título Manifesto Editorial com SlideUpText (Português) -->
		<div class="skills-headline-wrapper lang-pt">
			<!-- Versão Manifesto Desktop (4 Linhas com Indent) -->
			<h2 class="skills-headline skills-headline-desktop">
				<div class="skills-headline-row first-line">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.0} className="skills-text-white inline-flex">Sou um&nbsp;</SlideUpText>
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.06} className="skills-accent inline-flex">web designer que trabalha junto de marcas</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.16} className="skills-accent inline-flex">e fundadores para tirar ideias do papel.&nbsp;</SlideUpText>
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.24} className="skills-text-white inline-flex">Meu foco</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.32} className="skills-text-white inline-flex">está em criar interfaces claras, resolver problemas</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.42} className="skills-text-white inline-flex">de forma simples e cuidar dos detalhes em cada projeto.</SlideUpText>
				</div>
			</h2>

			<!-- Versão Mobile (Adaptação fluida) -->
			<h2 class="skills-headline skills-headline-mobile">
				<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.0} className="skills-accent">
					Sou um web designer que trabalha junto de marcas e fundadores para tirar ideias do papel. Meu foco está em criar interfaces claras, resolver problemas de forma simples e cuidar dos detalhes em cada projeto.
				</SlideUpText>
			</h2>
		</div>

		<!-- Bloco do Título Manifesto Editorial com SlideUpText (English) -->
		<div class="skills-headline-wrapper lang-en">
			<!-- Versão Manifesto Desktop (4 Linhas com Indent) -->
			<h2 class="skills-headline skills-headline-desktop">
				<div class="skills-headline-row first-line">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.0} className="skills-text-white inline-flex">I am a&nbsp;</SlideUpText>
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.06} className="skills-accent inline-flex">web designer working with brands and founders</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.16} className="skills-accent inline-flex">to bring ideas to life.&nbsp;</SlideUpText>
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.24} className="skills-text-white inline-flex">My focus is on crafting</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.32} className="skills-text-white inline-flex">clear interfaces, solving problems with simplicity,</SlideUpText>
				</div>
				<div class="skills-headline-row">
					<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.42} className="skills-text-white inline-flex">and obsessing over the details across every project.</SlideUpText>
				</div>
			</h2>

			<!-- Versão Mobile (Adaptação fluida) -->
			<h2 class="skills-headline skills-headline-mobile">
				<SlideUpText client:visible inView split="words" stagger={0.03} delay={0.0} className="skills-accent">
					I am a web designer working with brands and founders to bring ideas to life. My focus is on crafting clear interfaces, solving problems with simplicity, and obsessing over the details across every project.
				</SlideUpText>
			</h2>
		</div>

		<!-- Linha Inferior: Subtexto editorial alinhado na metade direita com SlideUpText -->
		<div class="skills-bottom-row">
			<div class="skills-col-spacer" aria-hidden="true"></div>
			<div class="skills-col-content">
				<div class="skills-description lang-pt">
					<SlideUpText client:visible inView split="words" stagger={0.018} delay={0.35}>
						Trabalho desde a primeira ideia até a versão final, criando websites e identidades visuais com atenção ao que realmente importa. Gosto de processos simples, boas decisões e projetos bem executados.
					</SlideUpText>
				</div>
				<div class="skills-description lang-en">
					<SlideUpText client:visible inView split="words" stagger={0.018} delay={0.35}>
						I work from initial concept to the final build, crafting websites and visual identities with genuine attention to what matters. I value straightforward processes, thoughtful decisions, and well-executed work.
					</SlideUpText>
				</div>
				<div class="skills-cta-wrap lang-pt">
					<Button href="#work" id="skills-cta-btn-pt">
						Ver Projetos
					</Button>
				</div>
				<div class="skills-cta-wrap lang-en">
					<Button href="#work" id="skills-cta-btn-en">
						View Projects
					</Button>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* --------------------------------------------------
	 * Estrutura Geral da Seção (#000000 — Preto Puro Idêntico à Hero)
	 * -------------------------------------------------- */
	.skills-section {
		position: relative;
		width: 100%;
		background-color: #000000;
		color: #ffffff;
		padding: clamp(5.5rem, 11vh, 9rem) clamp(1.5rem, 5.5vw, 80px);
		box-sizing: border-box;
		overflow: hidden;
		z-index: 20;
		box-shadow: none;
	}

	.skills-container {
		width: 100%;
		max-width: 1480px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
	}

	/* --------------------------------------------------
	 * Título Manifesto Editorial (4 Linhas Mascaradas)
	 * -------------------------------------------------- */
	.skills-headline-wrapper {
		width: fit-content;
		max-width: 100%;
		margin: 0 auto;
	}

	.skills-headline {
		margin: 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(1.95rem, 3.1vw, 3.35rem);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.038em;
		color: #ffffff;
		padding: 0.15em 0;
	}

	.skills-headline-desktop {
		display: block;
	}

	.skills-headline-mobile {
		display: none;
	}

	.skills-headline-row {
		display: flex;
		flex-wrap: nowrap;
		white-space: nowrap;
		align-items: baseline;
		width: 100%;
		max-width: 100%;
	}

	.skills-headline-row.first-line {
		padding-left: clamp(2.5rem, 5.5vw, 5.8rem);
	}

	.skills-text-white {
		color: #ffffff;
	}

	/* Cor linho suave do manifesto editorial */
	.skills-accent {
		color: #C8C6BA;
	}

	/* --------------------------------------------------
	 * Linha Inferior: Subtexto + Botão na Coluna Direita
	 * -------------------------------------------------- */
	.skills-bottom-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		width: 100%;
		max-width: 1080px;
		margin: clamp(3.5rem, 7vh, 5.5rem) auto 0 auto;
	}

	.skills-col-spacer {
		width: 100%;
	}

	.skills-col-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 520px;
	}

	.skills-description {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.9rem, 1.1vw, 0.975rem);
		font-weight: 400;
		line-height: 1.58;
		color: #D6D4CA;
		margin: 0 0 1.75rem 0;
		letter-spacing: -0.012em;
		display: flex;
		flex-direction: column;
		gap: 0.18em;
	}

	.skills-description .desc-line {
		display: block;
	}

	.skills-cta-wrap {
		display: flex;
		align-items: center;
		opacity: 0;
		transform: translateY(20px) scale(0.96);
		will-change: transform, opacity;
	}

	/* --------------------------------------------------
	 * Responsividade (Tablet e Mobile)
	 * -------------------------------------------------- */
	@media (max-width: 1024px) {
		.skills-section {
			padding: clamp(5rem, 9vh, 7.5rem) clamp(1.25rem, 3.5vw, 2.5rem);
		}

		.skills-container {
			max-width: 100%;
		}

		.skills-headline-wrapper {
			width: 100%;
			max-width: 100%;
		}

		.skills-headline-desktop {
			font-size: clamp(1.75rem, 2.8vw, 2.45rem);
			line-height: 1.25;
		}

		.skills-headline-row.first-line {
			padding-left: clamp(1.5rem, 3.5vw, 3rem);
		}
	}

	@media (max-width: 920px) {
		.skills-bottom-row {
			grid-template-columns: 1fr;
			margin-top: clamp(2.75rem, 5vh, 4rem);
		}

		.skills-col-spacer {
			display: none;
		}

		.skills-col-content {
			max-width: 620px;
		}
	}

	@media (max-width: 768px) {
		.skills-section {
			padding: 4.5rem clamp(1rem, 3.5vw, 1.5rem);
		}

		.skills-headline-desktop {
			display: none;
		}

		.skills-headline-mobile {
			display: block;
			width: 100%;
			max-width: 100%;
			font-size: clamp(1.68rem, 6.5vw, 2.4rem);
			line-height: 1.2;
			letter-spacing: -0.035em;
		}

		.skills-bottom-row {
			margin-top: 2.5rem;
		}

		.skills-col-content {
			width: 100%;
			max-width: 100%;
		}

		.skills-description {
			font-size: clamp(0.78rem, 3.2vw, 0.855rem);
			line-height: 1.54;
			letter-spacing: -0.018em;
			margin-bottom: 1.75rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	function setup() {
		// Animação de Entrada do Botão (o texto agora é controlado por SlideUpText)
		const bottomRow = document.querySelector('.skills-bottom-row') as HTMLElement | null;
		const btnWrap = document.querySelector('.skills-cta-wrap') as HTMLElement | null;

		if (!btnWrap) return;

		// Reseta estado inicial
		gsap.set(btnWrap, { opacity: 0, y: 20, scale: 0.96 });

		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set(btnWrap, { opacity: 1, y: 0, scale: 1 });
			return;
		}

		gsap.to(btnWrap, {
			opacity: 1,
			y: 0,
			scale: 1,
			duration: 0.55,
			ease: 'power2.out',
			scrollTrigger: {
				trigger: bottomRow || btnWrap,
				start: 'top 85%',
				toggleActions: 'play none none none',
				once: true,
			},
		});
	}

	// Run after DOM loaded & fonts ready
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', () => {
			document.fonts.ready.then(setup);
		});
	} else {
		document.fonts.ready.then(setup);
	}

	document.addEventListener('astro:after-swap', () => {
		document.fonts.ready.then(setup);
	});
</script>

