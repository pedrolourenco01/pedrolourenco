---
// Contact.astro — Rodapé minimalista e monumental com Marquee infinito "PEDRO LOURENÇO",
// linha divisória vertical em laranja (#EE5037) e links sociais alinhados na largura da Hero.
interface Props {
	email?: string;
	marqueeWord?: string;
	talkTitlePt?: string;
	talkTitleEn?: string;
	whatsappLink?: string;
	links?: Array<{ label: string; href: string; target?: string; rel?: string }>;
}

const defaultLinks = [
	{ label: "WhatsApp", href: "https://wa.me/5521971341163", target: "_blank", rel: "noopener noreferrer" },
	{ label: "Linkedin", href: "https://linkedin.com", target: "_blank", rel: "noopener noreferrer" },
	{ label: "Instagram", href: "https://www.instagram.com/pedrolouurenco/", target: "_blank", rel: "noopener noreferrer" },
	{ label: "Behance", href: "https://behance.net", target: "_blank", rel: "noopener noreferrer" },
	{ label: "Email", href: `mailto:pedrolourencowork04@gmail.com` }
];

const {
	email = "pedrolourencowork04@gmail.com",
	marqueeWord = "PEDRO LOURENCO",
	talkTitlePt = "VAMOS FALAR",
	talkTitleEn = "LET'S TALK",
	whatsappLink = "https://wa.me/5521971341163",
	links = defaultLinks
} = Astro.props;
---

<footer class="contact-section" id="contact" aria-label="Contact & Footer">
	<div class="contact-container">
		<!-- Topo: Marquee Monumental "PEDRO LOURENCO" com altura aumentada -->
		<div class="footer-marquee-wrapper" aria-hidden="true">
			<div class="footer-marquee-track">
				<!-- Grupo 1 -->
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
				<!-- Grupo 2 (Duplicado para loop infinito 100% contínuo) -->
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
				<span class="footer-marquee-item">PEDRO<span class="footer-marquee-dot" aria-hidden="true"></span>LOURENCO<span class="footer-marquee-dot" aria-hidden="true"></span></span>
			</div>
		</div>

		<!-- Área Inferior: Let's talk à Esquerda + Linha Vertical Laranja (#EE5037) Alongada + Links à Direita -->
		<div class="footer-body-grid">
			<!-- Coluna Esquerda: Texto Let's talk / Vamos Falar Pixelizado em Laranja -->
			<div class="footer-talk-col">
				<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="footer-talk-text lang-en" aria-label="Let's talk on WhatsApp">
					<span class="footer-talk-hop">{talkTitleEn}</span>
				</a>
				<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="footer-talk-text lang-pt" aria-label="Vamos falar no WhatsApp">
					<span class="footer-talk-hop">{talkTitlePt}</span>
				</a>
			</div>

			<!-- Divisor Vertical Laranja do Site (#EE5037) Estendido até a base -->
			<div class="footer-orange-divider" aria-hidden="true"></div>

			<!-- Coluna Direita: Links Sociais -->
			<nav class="footer-links-nav" aria-label="Contact & Social Links">
				<ul class="footer-links-list">
					{links.map((link) => (
						<li class="footer-link-item">
							<a
								href={link.href}
								target={link.target}
								rel={link.rel}
								class="footer-nav-link"
							>
								<span class="link-label">{link.label}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
		</div>
	</div>
</footer>

<style>
	/* --------------------------------------------------
	 * Estrutura Geral do Rodapé (Fundo Preto Absoluto #000000)
	 * -------------------------------------------------- */
	.contact-section {
		position: relative;
		width: 100%;
		height: 100%;
		min-height: 100vh;
		min-height: 100svh;
		background-color: #000000 !important;
		color: #FFFFFF;
		margin: 0;
		padding: 0;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		z-index: 10;
		will-change: transform;
		transform: translate3d(0, 0, 0);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	/* --------------------------------------------------
	 * Container com a MESMA LARGURA DA HERO
	 * -------------------------------------------------- */
	.contact-container {
		position: relative;
		width: 100%;
		max-width: 1920px;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 4vw, 4.5rem);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		flex: 1;
		justify-content: space-between;
	}

	/* --------------------------------------------------
	 * Marquee Monumental Superior "PEDRO LOURENÇO"
	 * Posicionado colado no topo como na referência OAH MILES
	 * Base alinhada exatamente no limite inferior do "Ç"
	 * -------------------------------------------------- */
	.footer-marquee-wrapper {
		width: 100%;
		overflow: hidden;
		position: relative;
		display: flex;
		align-items: flex-start;
		padding: 0.04em 0 0 0;
		margin-top: -0.04em;
		user-select: none;
		will-change: transform, opacity;
		opacity: 0;
		transform: translateY(35px);
	}

	.footer-marquee-track {
		display: flex;
		align-items: flex-start;
		white-space: nowrap;
		width: max-content;
		will-change: transform;
		animation: footerMarqueeInfinite 85s linear infinite;
		/* Efeito de hover removido: o marquee nunca para */
	}

	@keyframes footerMarqueeInfinite {
		0% {
			transform: translate3d(0, 0, 0);
		}
		100% {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.footer-marquee-item {
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(8.5rem, 23vw, 26rem);
		font-weight: 700;
		line-height: 1.0;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		color: #FFFFFF;
		white-space: nowrap;
		display: inline-block;
		margin-top: 0;
		padding-bottom: 0;
	}

	.footer-marquee-spacer {
		display: inline-block;
		width: clamp(3rem, 7vw, 8rem);
	}

	/* Quadrado Pixel Laranja (#EE5037) separando PEDRO de LOURENCO */
	.footer-marquee-dot {
		display: inline-block;
		width: 0.12em;
		height: 0.12em;
		background-color: #EE5037;
		border-radius: 0;
		margin: 0 0.22em;
		vertical-align: 0.29em;
		flex-shrink: 0;
	}

	/* --------------------------------------------------
	 * Grid Inferior: Linha Vertical Laranja (#EE5037) + Links
	 * Inicia exatamente colado na base das letras
	 * -------------------------------------------------- */
	.footer-body-grid {
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: stretch;
		flex: 1;
		min-height: clamp(300px, 46vh, 560px);
		margin-top: -0.06em;
		will-change: opacity, transform;
		opacity: 0;
		transform: translateY(25px);
	}

	.footer-talk-col {
		width: 100%;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: flex-start;
		padding-left: 0;
		padding-right: clamp(1rem, 2vw, 2.5rem);
		padding-bottom: clamp(3.5rem, 8vh, 6.5rem);
		padding-top: clamp(4rem, 10vh, 8rem);
		box-sizing: border-box;
	}

	.footer-talk-text {
		display: inline-flex;
		align-items: center;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(3.4rem, 6.6vw, 7.6rem);
		font-weight: 800;
		color: #EE5037;
		letter-spacing: 0.1em;
		line-height: 0.92;
		text-transform: uppercase;
		text-decoration: none;
		position: relative;
		transition: opacity 0.2s ease, transform 0.2s ease;
		cursor: pointer;
		white-space: nowrap;
	}

	/* Animação de pequenos pulinhos no texto LET'S TALK / VAMOS FALAR */
	.footer-talk-hop {
		display: inline-block;
		will-change: transform;
		animation: talkHop 1.9s ease-in-out infinite;
	}

	@keyframes talkHop {
		0%, 100% {
			transform: translateY(0);
		}
		18% {
			transform: translateY(-9px);
		}
		36% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
		64% {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.footer-talk-hop {
			animation: none !important;
		}
	}

	.footer-talk-text:hover {
		opacity: 0.85;
		transform: translateY(-2px);
	}

	/* Linha Laranja Oficial do Site (#EE5037) estendida até a base da tela (100% plana, sem sombra, sem neon e sem blur) */
	.footer-orange-divider {
		width: 2px;
		background-color: #EE5037;
		height: 100%;
		min-height: clamp(260px, 42vh, 520px);
		transform-origin: top center;
		box-shadow: none !important;
		filter: none !important;
		margin: 0;
	}

	/* Coluna de Links à Direita da Linha */
	.footer-links-nav {
		padding-left: clamp(0.6rem, 0.95vw, 0.95rem);
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: flex-start;
		padding-top: 0.25rem;
	}

	.footer-links-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: clamp(0.35rem, 0.6vh, 0.65rem);
		align-items: flex-start;
	}

	.footer-link-item {
		margin: 0;
		padding: 0;
		display: flex;
	}

	.footer-nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.65rem;
		margin: -0.1rem 0;
		font-family: 'Rethink Sans', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(1.15rem, 1.45vw, 1.65rem);
		font-weight: 500;
		color: #FFFFFF;
		text-decoration: none;
		letter-spacing: -0.015em;
		line-height: 1.15;
		transition: opacity 0.2s ease;
		cursor: pointer;
		white-space: nowrap;
	}

	.footer-nav-link::before {
		content: '';
		position: absolute;
		inset: 0;
		border: 1.5px dotted transparent;
		pointer-events: none;
		transition: border-color 0.2s ease;
	}

	.footer-nav-link:hover {
		opacity: 0.85;
	}

	.footer-nav-link:hover::before {
		border-color: currentColor;
	}

	/* --------------------------------------------------
	 * Responsividade (Mobile e Tablet)
	 * -------------------------------------------------- */
	@media (max-width: 768px) {
		.contact-section {
			padding: 0;
		}

		.footer-marquee-item {
			font-size: clamp(4.8rem, 20vw, 8.5rem);
			line-height: 0.96;
			margin-top: -0.03em;
			padding-bottom: 0;
		}

		.footer-marquee-spacer {
			width: clamp(2rem, 5vw, 3.5rem);
		}

		.footer-body-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			margin-top: -0.04em;
			min-height: auto;
		}

		.footer-orange-divider {
			display: none;
		}

		.footer-talk-col {
			padding: 2rem 1rem 0.5rem 1rem;
		}

		.footer-talk-text {
			font-size: clamp(2.4rem, 10vw, 4.2rem);
		}

		.footer-links-nav {
			padding: 0 1rem 3rem 1rem;
		}

		.footer-nav-link {
			font-size: 1.25rem;
		}
	}

	/* Desativa todos os efeitos de hover no mobile e touch: links e botões */
	@media (max-width: 900px), (hover: none), (pointer: coarse) {
		.footer-talk-text:hover,
		.footer-talk-text:active {
			opacity: 1 !important;
			transform: none !important;
		}

		.footer-nav-link:hover,
		.footer-nav-link:active {
			opacity: 1 !important;
			transform: none !important;
		}

		.footer-nav-link::before,
		.footer-nav-link:hover::before,
		.footer-nav-link:active::before {
			display: none !important;
			border-color: transparent !important;
		}
	}
</style>

<script>
	import gsap from 'gsap';

	function setupFooterReveal() {
		const marquee = document.querySelector('.footer-marquee-wrapper') as HTMLElement | null;
		const bodyGrid = document.querySelector('.footer-body-grid') as HTMLElement | null;
		const divider = document.querySelector('.footer-orange-divider') as HTMLElement | null;

		if (!marquee || !bodyGrid) return;

		// Estado inicial
		gsap.set(marquee, { opacity: 0, y: 35 });
		gsap.set(bodyGrid, { opacity: 0, y: 25 });
		if (divider) gsap.set(divider, { scaleY: 0, transformOrigin: 'top center' });

		const tl = gsap.timeline({ paused: true });

		tl.to(marquee, {
			opacity: 1,
			y: 0,
			duration: 0.85,
			ease: 'power3.out',
		}, 0)
		.to(bodyGrid, {
			opacity: 1,
			y: 0,
			duration: 0.75,
			ease: 'power3.out',
		}, 0.15)
		.to(divider, {
			scaleY: 1,
			duration: 0.95,
			ease: 'power2.out',
		}, 0.2);

		const onReveal = () => {
			tl.play();
		};

		const onHide = () => {
			tl.reverse();
		};

		window.addEventListener('footer:reveal', onReveal);
		window.addEventListener('footer:hide', onHide);

		// Se a cortina já estiver revelada no carregamento
		const shell = document.getElementById('footer-curtain-shell');
		if (shell && shell.classList.contains('is-revealed')) {
			tl.progress(1);
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupFooterReveal);
	} else {
		setupFooterReveal();
	}

	document.addEventListener('astro:after-swap', setupFooterReveal);
</script>
