---
// Contact.astro — Seção de Contato & Rodapé inspirada fielmente na referência visual
interface Props {
	email?: string;
}

const { email = "pedroworks@gmail.com" } = Astro.props;

const ctaText = "FALE COMIGO";

const navLinks = [
	{ label: "Início", href: "#hero" },
	{ label: "Projetos", href: "#work" },
	{ label: "Sobre", href: "#about" },
	{ label: "Habilidades", href: "#skills" }
];

const serviceLinks = [
	{ label: "Design UI/UX", href: "#skills" },
	{ label: "Direção Criativa", href: "#skills" },
	{ label: "Desenvolvimento Web", href: "#skills" },
	{ label: "Identidade de Marca", href: "#skills" }
];

const socialLinks = [
	{ label: "Instagram", href: "https://instagram.com" },
	{ label: "LinkedIn", href: "https://linkedin.com" },
	{ label: "Twitter / X", href: "https://twitter.com" },
	{ label: "Behance", href: "https://behance.net" }
];
---

<footer class="contact-section" id="contact" aria-label="Contato e Rodapé">
	<div class="contact-container">
		<!-- Cabeçalho Superior: Tem um projeto em mente? -->
		<header class="contact-eyebrow-wrap">
			<h2 class="contact-eyebrow">
				<span class="eyebrow-line">TEM UM PROJETO EM MENTE?</span>
				<span class="eyebrow-line">VAMOS CRIAR, DESENVOLVER E</span>
				<span class="eyebrow-line"><span class="eyebrow-accent">COLOCAR SEU PROJETO NO AR.</span></span>
			</h2>
		</header>

		<!-- Monumental Call to Action Link -->
		<div class="contact-cta-wrapper">
			<a href={`mailto:${email}`} class="contact-cta-link" aria-label="Enviar email para Pedro Lourenço">
				<span class="cta-text" aria-label={ctaText}>
					{ctaText.split('').map((char, index) => (
						<span class="contact-char-mask" aria-hidden="true">
							<span class="contact-char-inner" style={`--contact-char-idx: ${index}`}>
								<span class="char-hover-roll">
									<span class="char-primary">{char === ' ' ? '\u00A0' : char}</span>
									<span class="char-clone" aria-hidden="true">{char === ' ' ? '\u00A0' : char}</span>
								</span>
							</span>
						</span>
					))}
				</span>
				<span class="cta-arrow-wrap" aria-hidden="true">
					<svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="butt" stroke-linejoin="miter" class="cta-arrow-icon">
						<line x1="6" y1="18" x2="17.2" y2="6.8"></line>
						<polyline points="7 6 18 6 18 17"></polyline>
					</svg>
				</span>
			</a>
		</div>

		<!-- Grid de 3 Colunas do Rodapé (Navegação, Serviços, Social) -->
		<div class="footer-columns-grid">
			<!-- Coluna 1: Navegação Interna -->
			<div class="footer-col footer-col-nav">
				<h3 class="col-title">Navegação</h3>
				<ul class="col-list">
					{navLinks.map((item) => (
						<li>
							<a href={item.href} class="col-link">{item.label}</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Coluna 2: Serviços / Especialidades -->
			<div class="footer-col footer-col-services">
				<h3 class="col-title">Serviços</h3>
				<ul class="col-list">
					{serviceLinks.map((item) => (
						<li>
							<a href={item.href} class="col-link">{item.label}</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Coluna 3: Redes Sociais -->
			<div class="footer-col footer-col-social">
				<h3 class="col-title">Redes Sociais</h3>
				<ul class="col-list">
					{socialLinks.map((item) => (
						<li>
							<a href={item.href} target="_blank" rel="noopener noreferrer" class="col-link">
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>
	</div>

	<!-- Barra Inferior de Direitos Autorais -->
	<div class="copyright-bar">
		<div class="copyright-content">
			<p class="copyright-text">
				© 2026 Pedro Lourenço. Todos os direitos reservados.
			</p>
		</div>
	</div>
</footer>

<style>
	/* --------------------------------------------------
	 * Estrutura Principal da Seção (#0e0e0e Grafite Neutro Absoluto)
	 * -------------------------------------------------- */
	.contact-section {
		position: relative;
		width: 100%;
		background-color: #0e0e0e;
		color: #F2F1ED;
		overflow: hidden;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		z-index: 20;
	}

	.contact-container {
		width: 100%;
		max-width: 1480px;
		margin: 0 auto;
		padding: clamp(5.5rem, 11vh, 9.5rem) clamp(1.5rem, 5.5vw, 80px) clamp(4rem, 8vh, 6.5rem);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
	}

	/* --------------------------------------------------
	 * Cabeçalho Superior: Have A Project In Mind?
	 * -------------------------------------------------- */
	.contact-eyebrow-wrap {
		margin-bottom: clamp(3rem, 6vh, 4.5rem);
	}

	.contact-eyebrow {
		margin: 0;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(1.25rem, 2.7vw, 2.5rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
	}

	.eyebrow-line {
		color: #FFFFFF;
		display: inline-block;
		width: fit-content;
		max-width: 100%;
		opacity: 0;
	}

	.eyebrow-accent {
		color: #C8C6BA;
		font-weight: 700;
	}

	/* --------------------------------------------------
	 * Monumental Call to Action: CONTACT ME ↗
	 * -------------------------------------------------- */
	.contact-cta-wrapper {
		width: 100%;
		margin-bottom: clamp(5rem, 11vh, 9rem);
		overflow: visible;
	}

	.contact-cta-link {
		display: inline-flex;
		align-items: center;
		gap: clamp(1.5rem, 3.5vw, 3.5rem);
		text-decoration: none;
		color: #F2F1ED;
		cursor: pointer;
		outline: none;
		user-select: none;
		transition: opacity 0.25s ease;
		max-width: 100%;
		flex-wrap: nowrap;
	}

	.contact-cta-link:hover {
		opacity: 0.88;
	}

	.cta-text {
		font-family: 'Anton', Impact, 'Arial Black', sans-serif;
		font-size: clamp(3.2rem, 12vw, 11.5rem);
		font-weight: 900;
		line-height: 0.88;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		white-space: nowrap;
		display: inline-flex;
		align-items: flex-start;
		color: #F2F1ED;
	}

	.contact-char-mask {
		display: inline-block;
		overflow: hidden;
		vertical-align: bottom;
		height: 0.9em;
	}

	.contact-char-inner {
		display: inline-block;
		will-change: transform, opacity;
	}

	.char-hover-roll {
		display: flex;
		flex-direction: column;
		transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
		transition-delay: calc(var(--contact-char-idx, 0) * 0.022s);
		will-change: transform;
	}

	.char-primary,
	.char-clone {
		display: block;
		line-height: 0.9em;
		color: #F2F1ED;
		transition: color 0.3s ease;
	}

	.char-clone {
		color: #ffffff;
		opacity: 0.95;
	}

	.contact-cta-link:hover .char-hover-roll {
		transform: translateY(-50%);
	}

	.cta-arrow-wrap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: clamp(3.2rem, 12vw, 11.5rem);
		color: #F2F1ED;
		opacity: 0;
		transform: translate(-45px, 45px) scale(0.5) rotate(-20deg);
		transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.15s, transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
		will-change: transform, opacity;
	}

	.contact-cta-wrapper.is-in-view .cta-arrow-wrap {
		opacity: 1;
		transform: translate(0, 0) scale(1) rotate(0deg);
	}

	.contact-cta-link:hover .cta-arrow-wrap {
		transform: translate(10px, -10px) scale(1.08) rotate(0deg);
	}

	.contact-cta-link:hover {
		opacity: 1;
	}

	@media (max-width: 1200px), (max-width: 1280px) and (orientation: portrait), (hover: none) {
		.contact-cta-link:hover .char-hover-roll,
		.contact-cta-link:active .char-hover-roll {
			transform: none !important;
		}

		.contact-cta-link:hover .cta-arrow-wrap,
		.contact-cta-link:active .cta-arrow-wrap {
			transform: translate(0, 0) scale(1) rotate(0deg) !important;
		}

		.col-link:hover,
		.col-link:active {
			transform: none !important;
		}
	}

	/* --------------------------------------------------
	 * Grid de Rodapé: 3 Colunas (Navigation, Services, Social)
	 * -------------------------------------------------- */
	.footer-columns-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		column-gap: clamp(2rem, 5vw, 5rem);
		row-gap: 3.5rem;
		width: 100%;
		align-items: start;
		padding-top: clamp(2.5rem, 5vh, 4rem);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	/* Coluna 1: Bio / Resumo */
	.footer-col-bio {
		max-width: 480px;
	}

	.bio-text {
		margin: 0;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.85rem, 0.95vw, 0.95rem);
		font-weight: 400;
		line-height: 1.65;
		color: rgba(242, 241, 237, 0.85);
		letter-spacing: -0.01em;
	}

	/* Títulos das Colunas */
	.col-title {
		margin: 0 0 1.25rem 0;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.82rem, 0.95vw, 0.92rem);
		font-weight: 700;
		text-transform: capitalize;
		color: #FFFFFF;
		letter-spacing: -0.01em;
	}

	/* Listas de Links */
	.col-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.col-link {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.85rem, 0.95vw, 0.92rem);
		font-weight: 400;
		color: rgba(242, 241, 237, 0.75);
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
		display: inline-block;
	}

	.col-link:hover {
		color: #FFFFFF;
		transform: translateX(3px);
	}

	/* --------------------------------------------------
	 * Barra Inferior de Copyright
	 * -------------------------------------------------- */
	.copyright-bar {
		width: 100%;
		background-color: #EEECE4;
		color: #111215;
		padding: 1.35rem clamp(1.5rem, 5.5vw, 80px);
		box-sizing: border-box;
		border-top: 1px solid rgba(13, 52, 121, 0.08);
	}

	.copyright-content {
		max-width: 1480px;
		margin: 0 auto;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.copyright-text {
		margin: 0;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		font-size: clamp(0.78rem, 0.88vw, 0.88rem);
		font-weight: 600;
		color: #111215;
		letter-spacing: -0.01em;
		text-align: center;
	}

	/* --------------------------------------------------
	 * Responsividade (Tablet e Mobile)
	 * -------------------------------------------------- */
	@media (max-width: 1024px) {
		.footer-columns-grid {
			grid-template-columns: 1fr 1fr;
			row-gap: 3rem;
		}

		.footer-col-bio {
			grid-column: 1 / -1;
			max-width: 100%;
		}
	}

	@media (max-width: 768px) {
		.contact-container {
			padding: 4rem clamp(1.2rem, 4vw, 1.5rem) 3rem;
		}

		.contact-eyebrow-wrap {
			margin-bottom: 2.25rem;
		}

		.contact-cta-wrapper {
			margin-bottom: 1.75rem;
		}

		.contact-cta-link {
			gap: 0.85rem;
		}

		.cta-text {
			font-size: clamp(2.4rem, 14vw, 4.5rem);
		}

		.footer-columns-grid {
			grid-template-columns: 1fr;
			gap: 1.65rem;
			padding-top: 1.5rem;
		}

		.col-title {
			margin-bottom: 0.65rem;
			font-size: 0.85rem;
		}

		.col-list {
			gap: 0.4rem;
		}

		.col-link {
			font-size: 0.84rem;
		}

		.copyright-bar {
			padding: 1.15rem 1.25rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { initTextBlockReveal } from '../scripts/text-block-animation';

	gsap.registerPlugin(ScrollTrigger);

	function setupContact() {
		// 1. Text Block Revealer on Contact Eyebrow
		initTextBlockReveal('.contact-eyebrow', {
			blockColor: '#ffffff',
			trigger: '#contact',
			start: 'top 80%',
			duration: 0.65,
			stagger: 0.1,
			delay: 0.1,
		});

		// Respect prefers-reduced-motion
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			gsap.set(['.contact-char-inner', '.footer-col'], {
				y: 0,
				opacity: 1,
				scale: 1,
				rotate: 0,
			});
			return;
		}

		ScrollTrigger.getById('contact-entrance-trigger')?.kill();

		const tl = gsap.timeline({
			id: 'contact-entrance-trigger',
			scrollTrigger: {
				trigger: '#contact',
				start: 'top 75%',
				toggleActions: 'play none none reverse',
			},
		});

		// 2. Staggered letter reveal for CONTACT ME
		tl.fromTo(
			'.contact-char-inner',
			{
				y: '140%',
				opacity: 0,
			},
			{
				y: '0%',
				opacity: 1,
				duration: 0.8,
				stagger: 0.03,
				ease: 'expo.out',
			},
			0.1
		);

		// 3. Footer columns stagger up smoothly
		tl.fromTo(
			'.footer-col',
			{
				y: 28,
				opacity: 0,
			},
			{
				y: 0,
				opacity: 1,
				duration: 0.65,
				stagger: 0.06,
				ease: 'power2.out',
			},
			0.45
		);
	}

	function initFooterArrowObserver() {
		const ctaWrap = document.querySelector('.contact-cta-wrapper');
		if (!ctaWrap) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						ctaWrap.classList.add('is-in-view');
					}
				});
			},
			{ threshold: 0.15 }
		);

		observer.observe(ctaWrap);
	}

	let contactInitialized = false;
	function initOnce() {
		if (contactInitialized) return;
		contactInitialized = true;
		if (document.fonts) {
			document.fonts.ready.then(setupContact);
		} else {
			setupContact();
		}
		initFooterArrowObserver();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initOnce);
	} else {
		initOnce();
	}
	document.addEventListener('astro:after-swap', () => {
		contactInitialized = false;
		initOnce();
	});
</script>

